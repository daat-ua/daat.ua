---
import Footer from "../components/Footer.astro";
import GlobalMenu from "../components/GlobalMenu.astro";
import Header from "../components/Header.astro";
import Deliverables from "../components/atlas-landing/sections/Deliverables.astro";
import ForWhom from "../components/atlas-landing/sections/ForWhom.astro";
import Hero from "../components/atlas-landing/sections/Hero.astro";
import Testimonials from "../components/atlas-landing/sections/Testimonials.astro";
import Roadmap from "../components/atlas-landing/sections/Roadmap.astro";
import Methodology from "../components/atlas-landing/sections/Methodology.astro";
import Report from "../components/atlas-landing/sections/Report.astro";
import Scrub from "../components/atlas-landing/sections/Scrub.astro";
import WhyNow from "../components/atlas-landing/sections/WhyNow.astro";
import Toc from "../components/Toc.astro";
import Base from "../layouts/Base.astro";
---

<Base
  title="ATLAS — доказова діагностика зростання IT-компаній | Daat"
  description="ATLAS — доказова діагностика зростання IT-компаній від Daat. Перший результат — уже за 4–5 тижнів."
>
  <Header />
  <main id="main">
    <!-- Sections are ported one PR at a time from the legacy index.html -->
    <Hero />
    <Toc>
      <WhyNow />
      <Scrub />
      <ForWhom />
      <Deliverables />
      <Report />
      <Roadmap />
      <Testimonials />
      <Methodology />
    </Toc>
  </main>
  <Footer />
  <GlobalMenu />
</Base>
