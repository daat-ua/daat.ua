---
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../../layouts/Base.astro";
import Footer from "../../../components/Footer.astro";
import FoundersCta from "../../../components/findings/FoundersCta.astro";
import { episodes, thumbnail, thumbnailSrcset } from "../../../data/delivery-management";

// "Все про менеджмент делівері" (DAA-231): the index of Olena Kyianovska's video series. The previous site's
// "Делівері блог" block (DeliveryBlogTeaser) in this site's type: a dotted ground, a looping video that stays in
// view, and a panel in the ATLAS methodology's navy scrolling up over it, the latest episode large, then the rest.

const locale = Astro.currentLocale ?? "uk-UA";
const url = (path: string) => getRelativeLocaleUrl(locale, path, { normalizeLocale: false });
const episodeHref = (slug: string) => url(`delivery-management/${slug}`);
const [latest, ...rest] = episodes;
const intro =
  "Олена Кияновська розповідає про буремні (але дуже цікаві) моменти в роботі делівері-менеджера, ділиться безцінним досвідом обходження граблів та каменів. Для широкої аудиторії.";
---

<Base title="Все про менеджмент делівері | Daat" description={intro}>
  <main id="main" class="dm">
    <div class="dm-stage">
      <!-- the video stays in view while the episodes scroll up over it -->
      <div class="dm-video">
        <video
          src="/videos/delivery-management.mp4"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        ></video>
        <p class="dm-video__intro">{intro}</p>
      </div>

      <!-- the title and the episodes, in a column on the right, over the video -->
      <div class="dm-column">
        <header class="dm-head">
          <p class="dm-eyebrow">Наші проєкти</p>
          <h1 class="dm-title">Все про менеджмент делівері</h1>
        </header>

        <div class="dm-panel">
          <article class="dm-latest" aria-labelledby="dm-latest-title">
            <a class="dm-latest__media" href={episodeHref(latest.slug)} tabindex="-1" aria-hidden="true">
              <img
                src={thumbnail(latest.youtubeId, "maxresdefault")}
                srcset={thumbnailSrcset(latest.youtubeId)}
                sizes="(width < 64rem) 100vw, 50vw"
                alt=""
              />
              <span class="dm-play" aria-hidden="true"></span>
            </a>
            <h2 class="dm-latest__title" id="dm-latest-title">
              <a href={episodeHref(latest.slug)}>{latest.title}</a>
            </h2>
            <p class="dm-latest__lead">{latest.lead}</p>
            <a class="dm-button" href={episodeHref(latest.slug)}>
              Дивитися або читати
            </a>
          </article>

          <h2 class="dm-list__title">Усі випуски</h2>
          <ol class="dm-list">
            {rest.map((e) => (
              <li>
                <a href={episodeHref(e.slug)}>
                  <span class="dm-list__media">
                    <img
                      src={thumbnail(e.youtubeId, "mqdefault")}
                      srcset={thumbnailSrcset(e.youtubeId)}
                      sizes="176px"
                      alt=""
                      loading="lazy"
                    />
                  </span>
                  <span class="dm-list__text">
                    <span class="dm-list__name">{e.title}</span>
                    <span class="dm-list__teaser">{e.teaser}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>

    <FoundersCta
      finding="delivery-management"
      title="Хочете застосувати це у&nbsp;своїй компанії? <strong>Поговорімо</strong> про ваш delivery."
      lead="Олена й&nbsp;Сергій особисто ведуть кожну діагностику ATLAS. Оберіть зручний час для 30‑хвилинної розмови."
    />
  </main>
  <Footer />
</Base>

<script>
  // no looping video for readers who ask for less motion
  const video = document.querySelector<HTMLVideoElement>(".dm-video video");
  if (video && matchMedia("(prefers-reduced-motion: reduce)").matches) {
    video.removeAttribute("autoplay");
    video.pause();
  }
</script>

<style>
  .dm {
    --gutter-x: var(--gutter);
    background: var(--c-paper);
    color: var(--c-hero);
  }
  .dm a {
    color: inherit;
    text-decoration: none;
  }
  .dm p {
    margin: 0;
  }

  /* the title over the video, in light colours, above the panel; the eyebrow in the breadcrumb's type */
  .dm-head {
    display: grid;
    row-gap: var(--space-xl);
    padding-bottom: var(--space-2xl);
    color: var(--c-white);
  }
  .dm-eyebrow {
    color: rgb(237 233 222 / 0.85);
    font-size: var(--text-body);
    font-weight: 500;
    line-height: var(--leading-body);
  }
  .dm-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 600;
    line-height: var(--leading-display);
  }

  /* the dotted ground of the previous site's block, within the page's margins */
  .dm-stage {
    margin: 0 var(--gutter-x);
    background: url("data:image/svg+xml,%3Csvg width='8' height='8' viewBox='0 0 8 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='0.75' cy='0.75' r='0.75' fill='%230B0B0B'/%3E%3Ccircle cx='4.75' cy='4.75' r='0.75' fill='%230B0B0B'/%3E%3C/svg%3E")
      repeat;
  }
  /* the video runs edge to edge (out of the stage's margins), 720 tall at 1440, kept in view at the top while
     the title and the episodes scroll up over it */
  .dm-video {
    position: sticky;
    top: 0;
    z-index: 0;
    height: calc(720 * var(--px));
    margin: 0 calc(-1 * var(--gutter-x));
    overflow: hidden;
    background: var(--c-hero); /* under the shifted video's edge, where the dots would show */
  }
  .dm-video video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.12) translateX(-5.5%) translateY(5.5%);
  }
  .dm-video::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(28 38 50 / 0.6), rgb(28 38 50 / 0.5), rgb(28 38 50 / 0.6));
  }
  .dm-video__intro {
    position: absolute;
    z-index: 1;
    bottom: var(--space-3xl);
    left: var(--gutter-x);
    width: calc(var(--col) + var(--col-gap));
    color: rgb(255 255 255 / 0.88);
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  /* the column: 60% of the stage on the right, rising over the whole video, the title at its top */
  .dm-column {
    position: relative;
    z-index: 1;
    width: 60%;
    margin: calc(-720 * var(--px)) 0 0 auto;
    padding-top: var(--space-3xl);
  }
  .dm-panel {
    padding: var(--space-2xl) var(--space-2xl) var(--space-3xl);
    background: var(--c-hero);
    color: var(--c-cream);
  }
  /* the founders' block follows the panel directly */
  .dm :global(.founders-cta) {
    margin-top: 0;
  }
  .dm-latest {
    display: grid;
    justify-items: start;
    row-gap: var(--space-md);
  }
  .dm-latest__media,
  .dm-list__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--c-night);
  }
  .dm-latest__media {
    width: 100%;
    border-radius: 6px;
  }
  :is(.dm-latest__media, .dm-list__media) img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .dm-play {
    position: absolute;
    inset: 0;
    width: calc(80 * var(--px));
    height: calc(80 * var(--px));
    margin: auto;
    border-radius: 50%;
    background: var(--c-primary);
    box-shadow: 0 10px 30px rgb(14 21 27 / 0.4);
    transition: transform 0.2s var(--ease-out);
  }
  .dm-play::after {
    content: "";
    position: absolute;
    inset: 32% 30% 32% 38%;
    background: var(--c-white);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }
  .dm-latest__media:hover .dm-play {
    transform: scale(1.06);
  }
  .dm-latest__title {
    margin: 0;
    color: var(--c-white);
    font-family: var(--font-display);
    font-size: var(--text-heading);
    font-weight: 500;
    line-height: var(--leading-heading);
  }
  .dm-latest__title a:hover {
    text-decoration: underline;
    text-underline-offset: 0.12em;
    text-decoration-thickness: 2px;
  }
  .dm-latest__lead {
    color: rgb(237 233 222 / 0.8);
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }
  .dm .dm-button {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    min-height: calc(52 * var(--px));
    padding: 0 var(--space-lg);
    border-radius: 999px;
    background: var(--c-primary);
    color: var(--c-on-primary);
    font-size: var(--text-small);
    font-weight: 500;
    transition: background-color 0.2s ease;
  }
  .dm .dm-button::before {
    content: "";
    width: 0.8em;
    height: 0.9em;
    background: currentColor;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }
  .dm .dm-button:hover {
    background: var(--c-primary-hover);
  }
  .dm .dm-button:focus-visible {
    outline: 3px solid var(--c-accent);
    outline-offset: 3px;
  }

  .dm-list__title {
    margin: var(--space-2xl) 0 var(--space-xs);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid rgb(237 233 222 / 0.15);
    color: var(--c-white);
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 600;
    line-height: var(--leading-title);
  }
  .dm-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dm-list li + li {
    border-top: 1px solid rgb(237 233 222 / 0.12);
  }
  .dm-list a {
    display: grid;
    grid-template-columns: calc(176 * var(--px)) minmax(0, 1fr);
    column-gap: var(--space-md);
    align-items: start;
    padding: var(--space-md) 0;
  }
  .dm-list__media {
    border-radius: 4px;
  }
  .dm-list__text {
    display: grid;
    row-gap: var(--space-xs);
  }
  .dm-list__name {
    color: var(--c-white);
    font-size: var(--text-body);
    font-weight: 500;
    line-height: 1.3;
  }
  .dm-list a:hover .dm-list__name {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .dm-list__teaser {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    color: rgb(237 233 222 / 0.75);
    font-size: var(--text-small);
    line-height: var(--leading-body);
  }

  @media (width < 64rem) {
    .dm-head {
      row-gap: 24px;
      padding: 0 var(--gutter-x) 32px;
    }
    .dm-stage {
      margin: 0;
    }
    .dm-video {
      top: 0;
      height: 480px;
      margin: 0;
    }
    .dm-video__intro {
      display: none; /* the title takes the video's top; the intro would sit under the panel */
    }
    .dm-column {
      width: auto;
      margin-top: -480px;
      padding-top: 104px; /* clear of the logo hanging below the bar */
    }
    .dm-panel {
      padding: 32px var(--gutter-x) 64px;
    }
    .dm-list a {
      grid-template-columns: 120px minmax(0, 1fr);
      column-gap: 16px;
    }
  }
</style>
