---
import { getRelativeLocaleUrl } from "astro:i18n";
import { PortableText } from "astro-portabletext";
import Base from "../../../layouts/Base.astro";
import Footer from "../../../components/Footer.astro";
import Crumb from "../../../components/findings/Crumb.astro";
import TocCta from "../../../components/findings/TocCta.astro";
import FoundersCta from "../../../components/findings/FoundersCta.astro";
import Carousel, { type Teaser } from "../../../components/ui/Carousel.astro";
import { cover, isoDuration, youtubeId } from "../../../data/delivery-management";
import { sanityClient } from "../../../sanity/client";
import { DELIVERY_EPISODE_QUERY, DELIVERY_EPISODES_QUERY } from "../../../sanity/queries";

// An episode of "Все про менеджмент делівері" (DAA-231), in the findings pages' language: the cover blurred and
// faded behind the title, the player across the content width (YouTube loads only when the reader presses play),
// the episode retold as prose in a single column; then the other episodes as the site's carousel and the founders'
// block. Content: Sanity's "Delivery management episodes" (`deliveryEpisode`).

export async function getStaticPaths() {
  const episodes = await sanityClient.fetch(DELIVERY_EPISODES_QUERY);
  return episodes.map((e) => ({ params: { slug: e.slug }, props: { episodes } }));
}

const { slug } = Astro.params;
const { episodes } = Astro.props;
const episode = await sanityClient.fetch(DELIVERY_EPISODE_QUERY, { slug });
if (!episode) throw new Error(`No delivery management episode with the slug "${slug}"`);
const locale = Astro.currentLocale ?? "uk-UA";
const url = (path: string) => getRelativeLocaleUrl(locale, path, { normalizeLocale: false });

const videoId = youtubeId(episode.youtubeUrl);
const watchUrl = `https://www.youtube.com/watch?v=${videoId}`;
const image = cover(episode);

// the video for search engines: schema.org's VideoObject
const videoData = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: episode.title,
  description: episode.teaser,
  thumbnailUrl: image.src,
  uploadDate: episode.publishedAt,
  duration: isoDuration(episode.duration),
  embedUrl: `https://www.youtube-nocookie.com/embed/${videoId}`,
  contentUrl: watchUrl,
  ...(episode.author && { author: { "@type": "Person", name: episode.author } }),
};

// card titles go to the carousel as HTML, so the plain-text titles are escaped
const escape = (text: string) => text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const others: Teaser[] = episodes
  .filter((e) => e.slug !== episode.slug)
  .map((e) => ({
    image: cover(e),
    title: escape(e.title),
    href: url(`delivery-management/${e.slug}`),
  }));
---

<Base
  title={episode.seo_title || `${episode.title} | Все про менеджмент делівері`}
  description={episode.seo_description || episode.teaser}
  noindex={episode.no_index ?? false}
>
  <script type="application/ld+json" set:html={JSON.stringify(videoData).replace(/</g, "\\u003c")} />
  <main id="main" class="ep">
    <!-- ═══ First screen: the cover, blurred and faded into the paper ═══ -->
    <header class="ep-hero">
      <div class="ep-hero__art" aria-hidden="true">
        <img src={image.src} alt="" fetchpriority="high" />
      </div>
      <div class="wrap ep-hero__inner">
        <Crumb href={url("delivery-management")} label="Все про менеджмент делівері" />
        <h1 class="ep-title">{episode.title}</h1>
      </div>
    </header>

    <!-- ═══ The player, across the content width: the cover until the reader presses play ═══ -->
    <div class="wrap">
      <div class="ep-player" data-video={videoId} data-title={episode.title}>
        <a class="ep-player__poster" href={watchUrl} aria-label={`Дивитися відео «${episode.title}»`}>
          <img {...image} sizes="(width < 64rem) 100vw, 83vw" alt="" />
          <span class="ep-player__play" aria-hidden="true"></span>
        </a>
      </div>
    </div>

    <!-- ═══ The episode retold as prose, the call to action beside it ═══ -->
    <div class="wrap ep-layout">
      <article class="ep-body">
        <p class="ep-lead">{episode.lead}</p>
        {episode.body && <PortableText value={episode.body} />}
      </article>

      <!-- the findings pages' small call to action, kept in view beside the text -->
      <aside class="ep-aside" aria-label="Запис на дзвінок">
        <div class="ep-aside__inner">
          <TocCta title="Впізнали свою компанію?" />
        </div>
      </aside>
    </div>

    <!-- ═══ The other episodes: the site's carousel, three same-sized cards to a screen ═══ -->
    {others.length > 0 && (
      <section class="ep-others" aria-labelledby="ep-others-title">
        <div class="wrap">
          <h2 class="ep-others__title" id="ep-others-title">
            Інші випуски
          </h2>
          <Carousel
            label="Інші випуски"
            items={others}
            more="Дивитися"
            prevLabel="Попередні випуски"
            nextLabel="Наступні випуски"
          />
        </div>
      </section>
    )}

    <FoundersCta
      finding={`delivery-management:${episode.slug}`}
      title="Хочете застосувати це у&nbsp;своїй компанії? <strong>Поговорімо</strong> про ваш delivery."
      lead="Олена й&nbsp;Сергій особисто ведуть кожну діагностику ATLAS. Оберіть зручний час для 30‑хвилинної розмови."
    />
  </main>
  <Footer />
</Base>

<script>
  // The player: YouTube (its privacy-enhanced domain) loads only when the reader presses play. Without
  // JavaScript the poster opens the video on YouTube.
  const player = document.querySelector<HTMLElement>(".ep-player");
  if (player) {
    const play = () => {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${player.dataset.video}?autoplay=1&rel=0`;
      iframe.title = player.dataset.title ?? "";
      iframe.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      iframe.allowFullscreen = true;
      player.replaceChildren(iframe);
    };
    player.querySelector("a")?.addEventListener("click", (e) => {
      e.preventDefault();
      play();
    });
  }
</script>

<style>
  /* the findings pages' lighter paper */
  :global(body:has(.ep)) {
    --c-paper: color-mix(in srgb, var(--color-paper) 50%, var(--color-white));
  }
  .ep {
    --ink-soft: color-mix(in srgb, var(--c-hero) 72%, transparent);
    --rule: color-mix(in srgb, var(--c-hero) 12%, transparent);
    background: var(--c-paper);
    color: var(--c-hero);
  }
  .ep p,
  .ep-body :global(p) {
    margin: 0;
  }

  /* ---------- First screen ---------- */
  .ep-hero {
    position: relative;
    overflow: hidden;
  }
  .ep-hero__art {
    position: absolute;
    inset: 0;
  }
  .ep-hero__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(28px) saturate(1.1);
    transform: scale(1.15); /* the blur's soft edge falls outside */
  }
  .ep-hero__art::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--c-paper) 20%, transparent),
      color-mix(in srgb, var(--c-paper) 72%, transparent) 55%,
      var(--c-paper)
    );
  }
  .ep-hero__inner {
    position: relative;
    display: grid;
    row-gap: var(--space-xl);
    padding-top: calc(200 * var(--px));
    padding-bottom: var(--space-2xl);
  }
  .ep-title {
    max-width: var(--span-3);
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 600;
    line-height: var(--leading-display);
    font-feature-settings: "dlig" 1;
  }

  /* ---------- The player ---------- */
  .ep-player {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    background: var(--c-night);
  }
  .ep-player__poster,
  .ep-player :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .ep-player__poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ep-player__play {
    position: absolute;
    inset: 0;
    width: calc(104 * var(--px));
    height: calc(104 * var(--px));
    margin: auto;
    border-radius: 50%;
    background: var(--c-primary);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--c-night) 35%, transparent);
    transition: transform 0.2s var(--ease-out);
  }
  .ep-player__play::after {
    content: "";
    position: absolute;
    inset: 32% 30% 32% 38%;
    background: var(--c-white);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }
  .ep-player__poster:hover .ep-player__play {
    transform: scale(1.06);
  }
  .ep-player__poster:focus-visible {
    outline: 3px solid var(--c-accent);
    outline-offset: -3px;
  }

  /* ---------- The episode as prose at reading width, the findings pages' grid ---------- */
  .ep-layout {
    display: grid;
    grid-template-columns: var(--span-2) 1fr;
    column-gap: calc(var(--col-gap) * 2);
    padding-block: var(--space-3xl);
  }
  .ep-body {
    display: grid;
    align-content: start;
    row-gap: var(--space-md);
    min-width: 0;
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }
  /* as "on this page" sits on a finding: sticky, a little in from the column's edge; the prompt without its rule */
  .ep-aside__inner {
    position: sticky;
    top: var(--space-xl);
    width: 85%;
    padding-left: var(--space-lg);
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }
  .ep-aside :global(.toc-cta) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .ep-body :global(h3) {
    margin: var(--space-md) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 600;
    line-height: var(--leading-title);
  }
  .ep-body :global(blockquote) {
    margin: var(--space-xs) 0;
    padding-left: var(--space-md);
    border-left: 3px solid var(--c-primary);
    font-size: var(--text-lead);
  }
  .ep-body :global(a) {
    color: inherit;
    text-decoration-line: underline;
    text-underline-offset: 0.15em;
  }
  .ep-lead {
    margin-bottom: var(--space-xs);
    font-size: var(--text-lead);
  }

  /* ---------- Other episodes: the site's carousel, three equal 16:9 cards ---------- */
  .ep-others {
    padding-block: var(--space-3xl);
    border-top: 1px solid var(--rule);
  }
  .ep-others__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 600;
    line-height: var(--leading-title);
  }
  .ep-others :global(.findings) {
    width: 100%;
  }
  .ep-others :global(.finding),
  .ep-others :global(.finding:nth-child(3n + 2)),
  .ep-others :global(.finding:nth-child(3n)) {
    width: calc((100% - 2 * var(--col-gap)) / 3);
  }
  .ep-others :global(.finding__media) {
    aspect-ratio: 16 / 9;
  }
  .ep-others :global(.finding__title) {
    font-weight: 600;
  }

  @media (width < 64rem) {
    .ep-hero__inner {
      row-gap: 24px;
      padding-top: 104px;
      padding-bottom: 32px;
    }
    .ep-layout {
      grid-template-columns: 1fr;
      row-gap: 48px;
      padding-block: 56px;
    }
    .ep-aside__inner {
      position: static;
      width: auto;
      padding: 24px 0 0;
      border-top: 1px solid var(--rule);
    }
    .ep-player__play {
      width: 72px;
      height: 72px;
    }
    .ep-others {
      padding-block: 64px;
    }
    .ep-others :global(.finding),
    .ep-others :global(.finding:nth-child(3n + 2)),
    .ep-others :global(.finding:nth-child(3n)) {
      width: 78%;
    }
  }
</style>
