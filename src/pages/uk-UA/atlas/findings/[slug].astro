---
import { Image, Picture } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../../../layouts/Base.astro";
import Footer from "../../../../components/Footer.astro";
import AuditFindings from "../../../../components/atlas-landing/sections/AuditFindings.astro";
import author from "../../../../assets/images/insights/author-olena.webp";
import hero from "../../../../assets/images/insights/pm-skills-hero.webp";

// A delivery-audit finding, recreated from beta.daat.ua (where the content comes from Sanity) in this site's
// design: hero over the artwork, the article with its efforts radar and TL/DR, a sticky "on this page" list,
// and the ATLAS page's findings carousel. A sample for now: static content, kept out of search results.

// the breadcrumb leads to the findings catalogue (normalizeLocale: false keeps "uk-UA" as is, as in Logo)
const findingsHref = getRelativeLocaleUrl(Astro.currentLocale ?? "uk-UA", "atlas/findings", { normalizeLocale: false });

const toc = [
  { id: "who", label: "Хто такий проджект менеджер і які функції він виконує на проєкті?" },
  { id: "skills", label: "Яких навичок вимагає позиція проджект менеджера?" },
  { id: "assessment", label: "Які існують засоби для оцінки навичок проджект менеджерів в організації?" },
  { id: "why-invest", label: "Чому важливо завжди вкладатися у підвищення навичок проджект менеджерів?" },
];

// Efforts radar: how much each department is involved in solving the finding (0–100), drawn as a polar
// area chart — one equal-angle sector per department, its radius proportional to the effort.
const efforts = [
  { name: "Strategic management", value: 100 },
  { name: "Delivery excellence", value: 60 },
  { name: "Sales", value: 50 },
  { name: "Marketing", value: 96 },
  { name: "Company operations", value: 40 },
  { name: "People management", value: 10 },
  { name: "Financial control", value: 40 },
];
// each sector's shade of the navy, as on beta.daat.ua (by position, not by value)
const shades = [1, 0.8, 0.9, 0.6, 1, 0.9, 0.5];
const R = 100; // chart radius in SVG units
const step = (2 * Math.PI) / efforts.length;
const point = (r: number, a: number) => `${(r * Math.cos(a)).toFixed(2)} ${(r * Math.sin(a)).toFixed(2)}`;
const sectors = efforts.map(({ name, value }, i) => {
  const a0 = -Math.PI / 2 + i * step; // the first sector starts at 12 o'clock, then clockwise
  const a1 = a0 + step;
  const r = (R * value) / 100;
  const mid = a0 + step / 2;
  const lx = (R + 14) * Math.cos(mid);
  const ly = (R + 14) * Math.sin(mid);
  return {
    name,
    value,
    shade: shades[i],
    d: `M0 0L${point(r, a0)}A${r} ${r} 0 0 1 ${point(r, a1)}Z`,
    label: {
      x: lx.toFixed(2),
      y: ly.toFixed(2),
      anchor: Math.abs(lx) < 8 ? "middle" : lx > 0 ? "start" : "end",
      words: name.split(" "),
    },
  };
});
---

<Base
  title="Недостатні навички проджект менеджерів — знахідки делівері-аудитів | Daat"
  description="Хто такий проджект менеджер, яких навичок вимагає ця роль, як їх оцінювати і чому варто вкладатися в їхній розвиток."
  noindex
>
  <main id="main" class="finding-page">
    <!-- ═══ Hero: the artwork fades into the page ═══ -->
    <header class="finding-hero">
      <div class="finding-hero__art" aria-hidden="true">
        <Picture
          src={hero}
          alt=""
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[640, 960, 1440, 1920, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          layout="none"
        />
      </div>
      <div class="wrap finding-hero__inner">
        <nav aria-label="Хлібні крихти">
          <a class="finding-crumb" href={findingsHref}>
            Знахідки аудитів
          </a>
        </nav>
        <h1 class="finding-title">Недостатні навички проджект менеджерів</h1>
        <div class="finding-author">
          <Image src={author} alt="" widths={[96, 192]} sizes="96px" layout="none" />
          <div>
            <p class="finding-author__name">Олена Кияновська</p>
            <p class="finding-author__bio">
              Олена є керуючою партнеркою в Daat, CEO в компанії Alephbet та експерткою в делівері менеджменті.{" "}
              <a href="https://www.linkedin.com/in/helenkyianovska/" target="_blank" rel="noopener">
                <span class="finding-author__link">LinkedIn</span>
                <svg class="finding-author__ext" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M11.0991 3.00012C7.45013 3.00669 5.53932 3.09629 4.31817 4.31764C3.00034 5.63568 3.00034 7.75704 3.00034 11.9997C3.00034 16.2424 3.00034 18.3638 4.31817 19.6818C5.63599 20.9999 7.75701 20.9999 11.9991 20.9999C16.241 20.9999 18.3621 20.9999 19.6799 19.6818C20.901 18.4605 20.9906 16.5493 20.9972 12.8998"></path>
                  <path d="M20.556 3.49612L11.0487 13.0586M20.556 3.49612C20.062 3.00151 16.7343 3.04761 16.0308 3.05762M20.556 3.49612C21.05 3.99074 21.0039 7.32273 20.9939 8.02714"></path>
                </svg>
                <span class="visually-hidden"> (відкриється в новій вкладці)</span>
              </a>
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- ═══ Article + sticky "on this page" ═══ -->
    <div class="wrap finding-layout">
      <article class="finding-article">
        <p class="finding-lead">
          Project manager, проектний менеджер, менеджер проекту, проджект менеджер — це людина, яка відповідає за
          цілісність проєкту. Вони організовують роботу команди, управляють обмеженнями проєкту (терміни, бюджет,
          скоуп), а також забезпечують прозору комунікацію між клієнтом і командою.
        </p>

        <figure class="efforts">
          <figcaption class="efforts__title">
            Efforts radar <small>©</small>
          </figcaption>
          <p class="efforts__desc" id="efforts-desc">
            Розподілення зусиль, потрібних для вирішення цієї проблеми, між основними відділами компанії. Кожен сектор
            відображає рівень залученості відділу у вирішення знахідки.
          </p>
          <div class="efforts__body">
            <svg class="efforts__chart" viewBox="-215 -140 430 280" role="img" aria-labelledby="efforts-desc">
              {[20, 40, 60, 80, 100].map((r) => (
                <circle class="efforts__ring" r={r} />
              ))}
              {sectors.map((s) => (
                <g class="efforts__slice">
                  <path class="efforts__sector" d={s.d} style={`--shade: ${s.shade}`} />
                  <text class="efforts__label" x={s.label.x} y={s.label.y} text-anchor={s.label.anchor}>
                    {s.label.words.map((w, j) => (
                      <tspan x={s.label.x} dy={j === 0 ? `${(1 - s.label.words.length) * 0.55 + 0.35}em` : "1.1em"}>
                        {w}
                      </tspan>
                    ))}
                  </text>
                </g>
              ))}
            </svg>
            <div class="efforts__side">
              <ul class="efforts__list">
                {efforts.map((e) => (
                  <li>
                    <span>{e.name}</span>
                    <span class="efforts__bar" style={`--v: ${e.value}%`} aria-hidden="true" />
                    <span class="efforts__value">{e.value}%</span>
                  </li>
                ))}
              </ul>
              <a class="efforts__more" href="#" aria-disabled="true">
                Детальніше про методологію
              </a>
            </div>
          </div>
        </figure>

        <div class="finding-body">
          <h2 id="who">Хто такий проджект менеджер і які функції він виконує на проєкті?</h2>
          <p>
            Project manager, проектний менеджер, менеджер проекту, проджект менеджер — це людина, яка відповідає за
            цілісність проєкту. Вони організовують роботу команди, управляють обмеженнями проєкту (терміни, бюджет,
            скоуп), а також забезпечують прозору комунікацію між клієнтом і командою.
          </p>
          <p>Проджект менеджер — обовʼязки:</p>
          <ul>
            <li>планування проєкту та визначення його етапів;</li>
            <li>управління ресурсами (час, бюджет, команда);</li>
            <li>контроль виконання завдань і дотримання дедлайнів;</li>
            <li>управління ризиками;</li>
            <li>пошук рішень у кризових ситуаціях;</li>
            <li>контроль якості виконання проєкту;</li>
            <li>звітність перед стейкхолдерами та узгодження пріоритетів;</li>
            <li>підтримка ефективної взаємодії всередині команди.</li>
          </ul>
          <p>
            Без цієї ролі проєкти швидко втрачають контрольованість і перетворюються на набір окремих завдань без
            загальної мети.
          </p>

          <h2 id="skills">Яких навичок вимагає позиція проджект менеджера?</h2>
          <p>
            Роль проджект менеджера вимагає збалансованого набору знань та особистих якостей. З одного боку, він має
            добре розбиратися у процесах, інструментах та методологіях управління. З іншого — бути лідером, здатним
            надихати команду та будувати ефективну комунікацію.
          </p>
          <p>
            <strong>Хард-навички</strong> — це основа професійності проджект менеджера:
          </p>
          <ul>
            <li>
              <strong>Методології управління проєктами.</strong> Agile, Scrum, Kanban, Waterfall, PMI, PRINCE2 — не
              просто модні слова, а практичні підходи, які визначають, як працюватиме команда.
            </li>
            <li>
              <strong>Робота з бюджетами.</strong> Уміння планувати та контролювати витрати допомагає уникати перевитрат
              і забезпечує фінансову стабільність.
            </li>
            <li>
              <strong>Базове технічне розуміння.</strong> Проджект менеджер не має писати код, але має знати основи
              розробки, щоб коректно оцінювати ризики й часові витрати.
            </li>
            <li>
              <strong>Ризик-менеджмент.</strong> Виявлення проблем ще до того, як вони стали критичними, — ключ до
              стабільності.
            </li>
          </ul>
          <p>
            <strong>Софт-навички</strong> — це те, що відрізняє середнього менеджера від сильного:
          </p>
          <ul>
            <li>
              <strong>Комунікація та навички переговорів.</strong> Чітко та зрозуміло пояснювати завдання, доносити
              інформацію від клієнта до команди і навпаки.
            </li>
            <li>
              <strong>Лідерство.</strong> Надихати, підтримувати, вирішувати конфлікти, створювати середовище, де кожен
              відчуває себе важливим.
            </li>
            <li>
              <strong>Критичне мислення.</strong> Уміння зважити різні варіанти, знайти оптимальне рішення й
              аргументувати його.
            </li>
            <li>
              <strong>Емоційний інтелект.</strong> Розуміння емоцій і мотивацій людей, здатність пом’якшувати конфлікти
              та підтримувати здорову атмосферу.
            </li>
            <li>
              <strong>Адаптивність.</strong> Проєкти рідко йдуть ідеально за планом. Вміння швидко реагувати на зміни
              відрізняє сильного проджект менеджера від того, хто губиться при першій проблемі.
            </li>
          </ul>
          <p>
            Поєднання хард- і софт-скілів створює унікальний профіль спеціаліста, який здатен не просто координувати
            завдання, а й вести команду до результату.
          </p>

          <h2 id="assessment">Які існують засоби для оцінки навичок проджект менеджерів в організації?</h2>
          <p>
            Багато компаній покладаються на інтуїцію керівників, оцінюючи проджект менеджерів за загальним відчуттям
            «добре/погано справляється», кількістю ескалацій на проєкті, або як часто необхідне залучення менеджера
            вищої ланки для вирішення проблеми. Але такий підхід суб’єктивний і часто несправедливий. Щоб отримати
            реальну картину, варто застосовувати системні інструменти оцінки.
          </p>
          <p>Найпоширеніші засоби:</p>
          <ul>
            <li>
              <strong>Матриці компетенцій.</strong> Це таблиці, які описують, які саме навички потрібні проджект
              менеджеру на кожному рівні зрілості — від базового до експертного. Такі матриці дозволяють швидко
              визначити, де людина сильна, а де є прогалини.
            </li>
            <li>
              <strong>Зворотний зв’язок «на 360°».</strong> Проджект менеджера оцінюють колеги, підлеглі та керівники.
              Це допомагає отримати більш об’єктивний результат і зрозуміти, як він виглядає в очах різних груп.
            </li>
            <li>
              <strong>Performance review.</strong> Регулярні зустрічі для аналізу результатів роботи за конкретними
              показниками (кількість завершених проєктів, відхилення від бюджету, рівень задоволеності клієнтів).
            </li>
            <li>
              <strong>Сертифікації й тести.</strong> Міжнародні стандарти на кшталт PMP, PRINCE2, SAFe чи PMI-ACP
              дозволяють підтвердити професійний рівень проджект менеджера.
            </li>
            <li>
              <strong>Практичні кейси.</strong> Перевірка навичок у змодельованих умовах, наприклад: «Що ви зробите,
              якщо команда не вкладається в дедлайн через зовнішні залежності?»
            </li>
          </ul>
          <p>
            Системна оцінка допомагає не лише знайти слабкі місця, а й вибудовувати шлях розвитку для кожного менеджера,
            щоб його потенціал працював на користь компанії.
          </p>

          <h2 id="why-invest">Чому важливо завжди вкладатися у підвищення навичок проджект менеджерів?</h2>
          <p>
            Покращення навичок проджект менеджерів є критично важливим для успіху компанії та результатів проєктів. Ось
            чому:
          </p>
          <ul>
            <li>
              <strong>Підвищення ефективності проєктів.</strong> Досвідчені менеджери з більшою ймовірністю завершують
              проєкти вчасно та в межах бюджету, краще керують ризиками й передбачають потенційні проблеми.
            </li>
            <li>
              <strong>Зростання продуктивності команди.</strong> Розвинуті лідерські навички допомагають мотивувати
              команду, а ефективна комунікація забезпечує чітке делегування завдань і зрозумілі очікування.
            </li>
            <li>
              <strong>Краща взаємодія зі стейкхолдерами.</strong> Розвинуті навички переговорів і комунікації покращують
              відносини з клієнтами та партнерами, допомагають узгоджувати очікування й вирішувати конфлікти.
            </li>
            <li>
              <strong>Стратегічне узгодження.</strong> Покращене стратегічне мислення дозволяє узгоджувати проєкти з
              бізнес-цілями компанії та ефективніше розподіляти ресурси.
            </li>
            <li>
              <strong>Оптимізація ресурсів.</strong> Високі навички управління допомагають ефективніше використовувати
              час, бюджет і команду, краще виявляти й застосовувати сильні сторони людей.
            </li>
            <li>
              <strong>Покращення якості.</strong> Досвідчені менеджери впроваджують ефективні процеси контролю якості та
              швидко реагують на проблеми, які можуть зашкодити продукту.
            </li>
            <li>
              <strong>Управління ризиками.</strong> Сильні менеджери краще ідентифікують і зменшують ризики, готові до
              криз і непередбачених подій.
            </li>
            <li>
              <strong>Краща задоволеність клієнтів.</strong> Навички управління очікуваннями клієнтів допомагають
              будувати довготривалі партнерства й забезпечують цінність продукту.
            </li>
          </ul>
        </div>

        <section class="tldr" id="tldr" aria-labelledby="tldr-title">
          <h2 class="tldr__title" id="tldr-title">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8 16.5A6 6 0 0 1 6 12a6 6 0 0 1 12 0 6 6 0 0 1-2 4.5M12 12v4.5M9.5 19h5M10.5 21.5h3M12 2v1M21 12h-1M4 12H3M18.36 5.64l-.7.7M6.34 6.34l-.7-.7"></path>
            </svg>
            TL/DR, або швиденьке саммарі
          </h2>
          <ol>
            <li>
              <strong>Проджект менеджер відповідає за цілісність проєкту.</strong> Він організовує роботу команди,
              управляє обмеженнями (терміни, бюджет, скоуп) та забезпечує прозору комунікацію між клієнтом і командою.
            </li>
            <li>
              <strong>Обовʼязки ПМ охоплюють весь життєвий цикл проєкту.</strong> Від планування та управління ресурсами
              до контролю якості, управління ризиками, звітності перед стейкхолдерами та підтримки ефективної взаємодії
              в команді.
            </li>
            <li>
              <strong>Хард-навички формують професійну основу.</strong> Знання методологій (Agile, Scrum, Kanban,
              Waterfall), робота з бюджетами, базове технічне розуміння та ризик-менеджмент є критично важливими для
              успішного управління проєктами.
            </li>
            <li>
              <strong>Софт-навички відрізняють сильного менеджера від середнього.</strong> Комунікація, лідерство,
              критичне мислення, емоційний інтелект та адаптивність дозволяють не просто координувати завдання, а вести
              команду до результату.
            </li>
            <li>
              <strong>Суб’єктивна оцінка «на відчуття» недостатня.</strong> Для об’єктивної оцінки навичок ПМ потрібні
              системні інструменти: матриці компетенцій, зворотний зв’язок 360°, performance review, сертифікації та
              практичні кейси.
            </li>
            <li>
              <strong>Системна оцінка допомагає вибудовувати шлях розвитку.</strong> Вона дозволяє не лише знайти слабкі
              місця, а й створити індивідуальний план розвитку для кожного менеджера.
