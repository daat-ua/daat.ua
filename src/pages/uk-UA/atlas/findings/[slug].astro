---
import { getRelativeLocaleUrl } from "astro:i18n";
import { PortableText, toPlainText } from "astro-portabletext";
import FindingsLayout from "../../../../layouts/FindingsLayout.astro";
import FindingsToc from "../../../../components/findings/FindingsToc.astro";
import AuditFindings from "../../../../components/atlas-landing/sections/AuditFindings.astro";
import Heading from "../../../../components/portable-text/Heading.astro";
import Bulb from "../../../../assets/icons/icon-bulb.svg";
import { sanityClient } from "../../../../sanity/client";
import { srcsetFor, urlFor } from "../../../../sanity/image";
import { headingsOf } from "../../../../sanity/portable-text";
import { FINDING_QUERY, FINDING_SLUGS_QUERY } from "../../../../sanity/queries";

// A delivery-audit finding from the Sanity "Delivery audit findings" collection (`post`), one page per
// finding at build time: hero over the artwork, the article with its efforts radar and TL/DR, a sticky
// "on this page" list, and the findings carousel.

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch(FINDING_SLUGS_QUERY);
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const finding = await sanityClient.fetch(FINDING_QUERY, { slug });
if (!finding) throw new Error(`No finding with the slug "${slug}"`);

const { title, image, author, teaser, body, summarisation } = finding;

// the breadcrumb leads to the findings catalogue (normalizeLocale: false keeps "uk-UA" as is, as in Logo)
const findingsHref = getRelativeLocaleUrl(Astro.currentLocale ?? "uk-UA", "atlas/findings", { normalizeLocale: false });

const description = finding.seo_description ?? toPlainText(teaser ?? []).slice(0, 160);
const toc = headingsOf(body);
const bodyComponents = { block: { h2: Heading, h3: Heading } };

// Efforts radar: how much each department is involved in solving the finding (0–100), drawn as a polar
// area chart — one equal-angle sector per department, its radius proportional to the effort.
const departments = [
  "Strategic management",
  "Delivery excellence",
  "Sales",
  "Marketing",
  "Company operations",
  "People management",
  "Financial control",
];
// Until a finding's values are filled in, the chart shows beta.daat.ua's defaults (its component's
// fallback); once any are set, an unset one counts as 0.
const defaultEfforts = [100, 60, 50, 96, 40, 10, 40];
const anySet = finding.efforts.some((v) => typeof v === "number");
const efforts = departments.map((name, i) => ({
  name,
  value: anySet ? (finding.efforts[i] ?? 0) : defaultEfforts[i],
}));
// each sector's shade of the navy, as on beta.daat.ua (by position, not by value)
const shades = [1, 0.8, 0.9, 0.6, 1, 0.9, 0.5];
const R = 100; // chart radius in SVG units
const step = (2 * Math.PI) / departments.length;
const point = (r: number, a: number) => `${(r * Math.cos(a)).toFixed(2)} ${(r * Math.sin(a)).toFixed(2)}`;
const sectors = efforts.map(({ name, value }, i) => {
  const a0 = -Math.PI / 2 + i * step; // the first sector starts at 12 o'clock, then clockwise
  const a1 = a0 + step;
  const r = (R * value) / 100;
  const mid = a0 + step / 2;
  const lx = (R + 14) * Math.cos(mid);
  const ly = (R + 14) * Math.sin(mid);
  return {
    name,
    value,
    shade: shades[i],
    d: `M0 0L${point(r, a0)}A${r} ${r} 0 0 1 ${point(r, a1)}Z`,
    label: {
      x: lx.toFixed(2),
      y: ly.toFixed(2),
      anchor: Math.abs(lx) < 8 ? "middle" : lx > 0 ? "start" : "end",
      words: name.split(" "),
    },
  };
});
---

<FindingsLayout
  title={finding.seo_title ?? `${title} — знахідки аудитів | Daat`}
  description={description}
  noindex={finding.no_index ?? false}
  image={image}
  crumb={{ href: findingsHref, label: "Знахідки аудитів" }}
  heading={title}
>
  {author && (
    <div class="finding-author" slot="hero">
      {author.photo?.asset && (
        <img
          src={urlFor(author.photo).width(192).height(192).fit("crop").url()}
          srcset={srcsetFor(author.photo, [96, 192], 1)}
          sizes="96px"
          alt=""
          width="96"
          height="96"
        />
      )}
      <div>
        <p class="finding-author__name">{author.name}</p>
        <p class="finding-author__bio">
          {author.bio}{" "}
          {author.linkedin_link && (
            <a href={author.linkedin_link} target="_blank" rel="noopener">
              <span class="finding-author__link">LinkedIn</span>
              <svg class="finding-author__ext" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M11.0991 3.00012C7.45013 3.00669 5.53932 3.09629 4.31817 4.31764C3.00034 5.63568 3.00034 7.75704 3.00034 11.9997C3.00034 16.2424 3.00034 18.3638 4.31817 19.6818C5.63599 20.9999 7.75701 20.9999 11.9991 20.9999C16.241 20.9999 18.3621 20.9999 19.6799 19.6818C20.901 18.4605 20.9906 16.5493 20.9972 12.8998" />
                <path d="M20.556 3.49612L11.0487 13.0586M20.556 3.49612C20.062 3.00151 16.7343 3.04761 16.0308 3.05762M20.556 3.49612C21.05 3.99074 21.0039 7.32273 20.9939 8.02714" />
              </svg>
              <span class="visually-hidden"> (відкриється в новій вкладці)</span>
            </a>
          )}
        </p>
      </div>
    </div>
  )}

  <!-- ═══ Article + sticky "on this page" ═══ -->
  <div class="wrap finding-layout">
    <article class="finding-article">
      {teaser && (
        <div class="finding-lead">
          <PortableText value={teaser} />
        </div>
      )}

      <figure class="efforts">
        <figcaption class="efforts__title">
          Efforts radar <small>©</small>
        </figcaption>
        <p class="efforts__desc" id="efforts-desc">
          Розподілення зусиль, потрібних для вирішення цієї проблеми, між основними відділами компанії. Кожен сектор
          відображає рівень залученості відділу у вирішення знахідки.
        </p>
        <div class="efforts__body">
          <svg class="efforts__chart" viewBox="-215 -140 430 280" role="img" aria-labelledby="efforts-desc">
            {[20, 40, 60, 80, 100].map((r) => (
              <circle class="efforts__ring" r={r} />
            ))}
            {sectors.map((s) => (
              <g class="efforts__slice">
                <path class="efforts__sector" d={s.d} style={`--shade: ${s.shade}`} />
                <text class="efforts__label" x={s.label.x} y={s.label.y} text-anchor={s.label.anchor}>
                  {s.label.words.map((w, j) => (
                    <tspan x={s.label.x} dy={j === 0 ? `${(1 - s.label.words.length) * 0.55 + 0.35}em` : "1.1em"}>
                      {w}
                    </tspan>
                  ))}
                </text>
              </g>
            ))}
          </svg>
          <div class="efforts__side">
            <ul class="efforts__list">
              {efforts.map((e) => (
                <li>
                  <span>{e.name}</span>
                  <span class="efforts__bar" style={`--v: ${e.value}%`} aria-hidden="true" />
                  <span class="efforts__value">{e.value}%</span>
                </li>
              ))}
            </ul>
            <a class="efforts__more" href="#" aria-disabled="true">
              Детальніше про методологію
            </a>
          </div>
        </div>
      </figure>

      {body && (
        <div class="finding-body">
          <PortableText value={body} components={bodyComponents} />
        </div>
      )}

      {summarisation && (
        <section class="tldr" id="tldr" aria-labelledby="tldr-title">
          <h2 class="tldr__title" id="tldr-title">
            <Bulb class="tldr__icon" aria-hidden="true" />
            Коротка версія
          </h2>
          <PortableText value={summarisation} />
        </section>
      )}
    </article>

    {toc.length > 0 && (
      <FindingsToc items={toc}>
        {summarisation && (
          <a class="finding-toc__tldr" href="#tldr">
            <Bulb class="finding-toc__tldr-icon" aria-hidden="true" />
            <span>Немає часу читати? Переходьте до швидкого саммарі статті</span>
          </a>
        )}
      </FindingsToc>
    )}
  </div>

  <!-- ═══ More findings: the ATLAS page's findings carousel, without this one ═══ -->
  <div class="more-findings">
    <AuditFindings title="Більше знахідок аудитів" catalogLink={false} intro={false} exclude={slug} />
  </div>
</FindingsLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---------- Hero: the author under the title ---------- */
  .finding-author {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    max-width: var(--span-2); /* the article column's width */
  }
  .finding-author :global(img) {
    flex: none;
    width: calc(96 * var(--px));
    height: calc(96 * var(--px));
    border-radius: 50%;
    object-fit: cover;
  }
  .finding-author p {
    margin: 0;
  }
  .finding-author__name {
    font-size: var(--text-body);
    font-weight: 600;
  }
  .finding-author__bio {
    margin-top: var(--space-xs) !important;
    color: var(--ink-soft);
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }
  .finding-author__bio a {
    color: var(--c-primary);
  }
  /* only the word is underlined, not the gap or the icon after it */
  .finding-author__link {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  /* "opens elsewhere" mark, part of the link (same colour, same target) */
  .finding-author__ext {
    display: inline-block;
    width: 0.81em;
    height: 0.81em;
    vertical-align: -0.05em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------- Article + sticky "on this page" ---------- */
  .finding-layout {
    display: grid;
    grid-template-columns: var(--span-2) 1fr;
    column-gap: calc(var(--col-gap) * 2);
    padding-bottom: var(--space-md); /* no top padding: the hero's bottom padding is the gap */
  }
  .finding-article {
    --gap: var(--space-2xl); /* between the article's blocks */
    --gap-tight: var(--space-lg); /* within the intro: lead, efforts radar, body */
    display: grid;
    row-gap: var(--gap);
    min-width: 0;
  }
  .finding-article > :is(.efforts, .finding-body) {
    margin-top: calc(var(--gap-tight) - var(--gap));
  }
  .finding-lead {
    font-size: var(--text-body); /* the same size as the article body */
    line-height: var(--leading-body);
  }
  /* The lead, body and TL/DR are rendered by the Portable Text components, outside this page's scope:
     their elements are styled through :global() under these containers. */
  .finding-lead :global(p) {
    margin: 0;
  }
  .finding-lead :global(p + p) {
    margin-top: var(--space-md);
  }

  /* efforts radar */
  .efforts {
    /* the radar's colours, as on beta.daat.ua */
    --radar-ink: oklch(26% 17% 256deg); /* daat-main-1 */
    --radar-label: rgb(2 40 48);
    --radar-link-hover: oklch(57% 59% 263deg); /* daat-accent-1 */
    margin: 0;
    padding-block: var(--space-xl);
    border-block: 1px solid var(--rule);
  }
  .efforts__title {
    font-size: var(--text-body);
    font-weight: 600;
  }
  /* the explainer runs the full width, above the chart and the breakdown */
  .efforts__desc {
    margin: var(--space-sm) 0 0;
    padding-bottom: var(--space-md);
    color: var(--ink-soft);
    font-size: var(--text-small);
    line-height: var(--leading-body);
  }
  .efforts__body {
    display: grid;
    grid-template-columns: 56.25fr 43.75fr; /* the chart 25% wider than an even 45 : 55 split */
    align-items: center;
    gap: var(--space-lg);
    margin-top: var(--space-md);
  }
  .efforts__chart {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .efforts__ring {
    fill: none;
    stroke: rgb(0 0 0 / 0.1);
  }
  .efforts__sector {
    fill: var(--radar-ink);
    fill-opacity: var(--shade);
    stroke: var(--c-paper);
    stroke-width: 2;
  }
  .efforts__label {
    fill: var(--radar-label);
    font-size: 17px; /* SVG units: about 11px on screen at the desktop chart size */
    font-weight: 600;
  }
  .efforts__side {
    display: grid;
    row-gap: var(--space-md);
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }
  /* one column grid for all rows (subgrid): names as wide as the longest, bars share the rest */
  .efforts__list {
    display: grid;
    grid-template-columns: max-content 1fr max-content;
    gap: var(--space-xs) var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .efforts__list li {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
    color: oklch(26% 17% 256deg / 70%);
  }
  .efforts__bar {
    height: 6px;
    border-radius: 3px;
    background: linear-gradient(var(--radar-ink), var(--radar-ink)) 0 0 / var(--v) 100% no-repeat
      oklch(26% 17% 256deg / 10%);
  }
  .efforts__value {
    color: oklch(26% 17% 256deg / 50%);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .efforts__more {
    justify-self: start;
    color: oklch(26% 17% 256deg / 60%);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    transition: color 0.3s ease;
  }
  .efforts__more:hover {
    color: var(--radar-link-hover);
  }

  /* article body */
  .finding-body {
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }
  .finding-body :global(h2),
  .finding-body :global(h3) {
    margin: var(--space-2xl) 0 var(--space-md);
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 500;
    line-height: var(--leading-title);
    scroll-margin-top: var(--space-xl);
  }
  .finding-body :global(h3) {
    margin-top: var(--space-xl);
    font-size: var(--text-lead);
  }
  .finding-body :global(:is(h2, h3):first-child) {
    margin-top: 0;
  }
  .finding-body :global(p),
  .finding-body :global(ul) {
    margin: 0 0 var(--space-md);
  }
  .finding-body :global(ul) {
    display: grid;
    row-gap: var(--space-xs);
    padding: 0;
    list-style: none;
  }
  .finding-body :global(li) {
    position: relative;
    padding-left: 1.6em; /* not a grid: items mix bold lead-ins with plain text */
  }
  /* rounded-square bullet, in the accent like the icon bullets on the ATLAS page */
  .finding-body :global(li)::before {
    content: "";
    position: absolute;
    top: calc((var(--leading-body) * 1em - 1em) / 2); /* centred on the first line */
    left: 0;
    width: 1em;
    height: 1em;
    background: var(--c-accent);
    -webkit-mask: url("../../../../assets/icons/icon-square.svg") center / contain no-repeat;
    mask: url("../../../../assets/icons/icon-square.svg") center / contain no-repeat;
  }
  .finding-body :global(strong) {
    font-weight: 500;
  }
  .tldr :global(strong) {
    font-weight: 600;
  }

  /* TL/DR */
  /* The heading's icon and the list's numbers hang in the left padding, so the heading and the items
     start at one edge (--tldr-indent from the box's side). */
  .tldr {
    --tldr-icon: calc(var(--text-title) * 1.1); /* ~28px at 1440 */
    --tldr-indent: calc(var(--space-lg) + var(--tldr-icon) + var(--space-sm));
    padding: var(--space-xl) var(--space-xl) 0 var(--tldr-indent);
    border-radius: 6px; /* as the panels and teaser images on the ATLAS page */
    background: linear-gradient(to bottom, color-mix(in srgb, var(--c-accent) 14%, var(--c-paper)), var(--c-paper));
    font-size: var(--text-small);
    line-height: var(--leading-body);
    scroll-margin-top: var(--space-xl);
  }
  .tldr__title {
    position: relative;
    margin: 0 0 var(--space-md);
    /* the article's section headings' type */
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 500;
    line-height: var(--leading-title);
  }
  .tldr__title :global(.tldr__icon) {
    position: absolute;
    top: 50%;
    right: calc(100% + var(--space-sm));
    width: var(--tldr-icon);
    height: var(--tldr-icon);
    translate: 0 -50%;
    color: #c47a1e; /* the accent, darkened to read on the light ground */
  }
  /* numbers hang to the left of the text, right-aligned, with a gap of their own */
  .tldr :global(ol) {
    display: grid;
    row-gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: tldr;
  }
  .tldr :global(ol > li) {
    position: relative;
    counter-increment: tldr;
  }
  .tldr :global(ol > li)::before {
    content: counter(tldr) ".";
    position: absolute;
    right: calc(100% + 0.75em);
    font-variant-numeric: tabular-nums;
  }

  /* "on this page": the link to the short version at the list's foot */
  .finding-toc__tldr {
    display: flex;
    gap: 0.5em;
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--rule);
    color: var(--c-primary);
  }
  .finding-toc__tldr :global(.finding-toc__tldr-icon) {
    flex: none;
    width: 1.25em; /* the TL/DR heading's icon, smaller */
    height: 1.25em;
    margin-top: calc((var(--leading-small) * 1em - 1.25em) / 2); /* centred on the first line */
  }
  .finding-toc__tldr:hover span {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* ---------- More findings ---------- */
  .more-findings {
    border-bottom: 1px solid var(--rule);
  }
  /* the section's own paddings, cut: the top halved (the article above already ends with its bottom
     padding), the bottom to half its 160 */
  .more-findings :global(.report) {
    padding-top: var(--space-xl);
    padding-bottom: calc((var(--space-3xl) + var(--space-2xl)) * 0.5);
  }

  @media (width < 64rem) {
    .finding-author {
      gap: 16px;
    }
    .finding-author :global(img) {
      width: 64px;
      height: 64px;
    }
    .finding-layout {
      grid-template-columns: 1fr;
      padding-bottom: 24px;
    }
    .finding-article {
      --gap: 48px;
      --gap-tight: 24px;
    }
    .efforts__body {
      grid-template-columns: 1fr;
    }
    .efforts__chart {
      justify-self: center;
      max-width: 380px; /* keeps the labels near the body text size */
    }
    .tldr {
      --tldr-indent: calc(20px + var(--tldr-icon) + var(--space-sm));
      padding: 32px 20px 0 var(--tldr-indent);
    }
    .more-findings :global(.report) {
      padding-top: 32px;
      padding-bottom: 40px; /* half its 80 */
    }
  }
</style>
