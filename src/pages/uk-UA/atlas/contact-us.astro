</style>

<script>
  // The testimonials card: one testimonial at a time, the arrows step through them (the cover behind and the player
  // change together). Once the card is near the screen the shown video is attached under its poster
  // and starts buffering (src/scripts/hls-video.ts); its play button fades the poster out and plays it with the
  // native controls; stepping away pauses it, and at its end the poster comes back.
  import { attach, startPlaying } from "../../../scripts/hls-video";

  const panel = document.querySelector<HTMLElement>(".cu-panel");
  if (panel) {
    const count = Number(panel.dataset.count);
    const stories = [...panel.querySelectorAll<HTMLElement>(".cu-story")];
    const videoOf = (i: number) => stories[i].querySelector("video")!;
    let current = 0;
    let near = false;

    const stop = (i: number) => {
      const video = videoOf(i);
      video.pause();
      video.controls = false;
      stories[i].querySelector(".cu-video")!.classList.remove("is-playing");
    };

    const show = (i: number) => {
      stop(current);
      current = (i + count) % count;
      for (const el of panel.querySelectorAll<HTMLElement>("[data-slide]")) {
        el.hidden = Number(el.dataset.slide) !== current;
      }
      if (near) attach(videoOf(current)).catch(() => {});
    };

    for (const button of panel.querySelectorAll<HTMLButtonElement>(".cu-pager button")) {
      button.addEventListener("click", () => show(current + Number(button.dataset.step)));
    }

    stories.forEach((story, i) => {
      const box = story.querySelector<HTMLElement>(".cu-video")!;
      const video = videoOf(i);
      story.querySelector(".cu-video__play")!.addEventListener("click", async () => {
        try {
          await attach(video);
        } catch {
          return; // the player didn't load (offline, say): the poster stays, the next press tries again
        }
        box.classList.add("is-playing");
        video.controls = true;
        startPlaying(video);
        video.play().catch(() => stop(i));
        video.focus();
      });
      video.addEventListener("ended", () => stop(i));
    });

    new IntersectionObserver(
      (entries, observer) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        near = true;
        observer.disconnect();
        attach(videoOf(current)).catch(() => {});
      },
      { rootMargin: "50% 0px" },
    ).observe(panel);
  }

  // The request form: the name and a valid email are needed (said under the field, on submit and as they're
  // fixed); then it's posted as JSON and the form gives way to the "sent" message. Without an endpoint the dev
  // server simulates it, and a production build says it couldn't send, with the booking link.
  const form = document.querySelector<HTMLFormElement>(".cu-form");
  if (form) {
    const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
    const checks: [HTMLInputElement, (value: string) => boolean][] = [
      [field("name"), (v) => v.length > 0],
      [field("email"), (v) => EMAIL.test(v)],
    ];
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]")!;
    const submitError = form.querySelector<HTMLElement>("[data-submit-error]")!;
    const done = form.querySelector<HTMLElement>("[data-done]")!;

    const check = (input: HTMLInputElement, valid: (value: string) => boolean) => {
      const ok = valid(input.value.trim());
      input.setAttribute("aria-invalid", String(!ok));
      document.getElementById(input.getAttribute("aria-describedby")!)!.hidden = ok;
      return ok;
    };
    // once an error is shown, it goes as soon as the field is right
    for (const [input, valid] of checks) {
      input.addEventListener("input", () => {
        if (input.getAttribute("aria-invalid") === "true") check(input, valid);
      });
    }

    async function send(data: Record<string, string>) {
      const { mode, endpoint } = form!.dataset;
      if (mode === "demo") return new Promise((resolve) => setTimeout(resolve, 600));
      if (mode !== "live" || !endpoint) throw new Error("no endpoint");
      const response = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(data),
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      submitError.hidden = true;
      const invalid = checks.filter(([input, valid]) => !check(input, valid));
      if (invalid.length) {
        invalid[0][0].focus();
        return;
      }
      const data = Object.fromEntries(
        [...new FormData(form)].map(([key, value]) => [key, String(value).trim()]),
      ) as Record<string, string>;
      submit.setAttribute("aria-busy", "true");
      submit.disabled = true;
      try {
        if (!data.website) {
          delete data.website;
          await send({ ...data, page: location.pathname });
        }
        form.reset();
        done.hidden = false;
      } catch {
        submitError.hidden = false;
      } finally {
        submit.removeAttribute("aria-busy");
        submit.disabled = false;
      }
    });
  }
</script>
