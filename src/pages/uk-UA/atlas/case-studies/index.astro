---
import { getRelativeLocaleUrl } from "astro:i18n";
import FindingsLayout from "../../../../layouts/FindingsLayout.astro";
import FoundersCta from "../../../../components/findings/FoundersCta.astro";
import { commissionedByNames, industryNames } from "../../../../data/case-studies";
import { sanityClient } from "../../../../sanity/client";
import { srcsetFor, urlFor } from "../../../../sanity/image";
import { CASE_STUDY_TEASERS_QUERY } from "../../../../sanity/queries";
import heroImage from "../../../../assets/images/case-studies-hero.jpg";

// The case studies index (DAA-229), design B4 of the "Case studies index" canvas: the findings pages' title
// block, the featured case on navy with its main figure, then every other case as a wide row, photo and text
// alternating sides; the founders' block closes the page. Cases: Sanity's published "Case Studies", newest
// first; the featured one is the newest marked "featured", else the newest.

const locale = Astro.currentLocale ?? "uk-UA";
const url = (path: string) => getRelativeLocaleUrl(locale, path, { normalizeLocale: false });
const caseHref = (slug: string) => url(`atlas/case-studies/${slug}`);

const all = (await sanityClient.fetch(CASE_STUDY_TEASERS_QUERY)).filter((c) => c.heroImage?.asset);
const featured = all.find((c) => c.featured) ?? all[0];
const rest = all.filter((c) => c !== featured);
/** "IT-сервіси / аутсорс · ~50 людей · Засновник-CEO": the card tag (or industry and size), then who commissioned it */
const meta = (c: (typeof all)[number]) =>
  [
    c.cardTag || `${industryNames[c.industry]} · ${c.companySize}`,
    c.commissionedBy && commissionedByNames[c.commissionedBy],
  ]
    .filter(Boolean)
    .join(" · ");

const intro =
  "Як діагностика ATLAS працювала в реальних компаніях: з чим прийшов клієнт, що знайшли і що змінилося. Назви компаній приховано за їхньою згодою.";
---

<FindingsLayout
  title="Кейси | Daat"
  description={intro}
  image={heroImage}
  crumb={{ href: url("atlas"), label: "ATLAS" }}
  heading="Кейси"
>
  <p class="cases-intro" slot="hero">
    {intro}
  </p>

  <div class="wrap cases">
    {featured ? (
      <article class="cases-featured" aria-labelledby="cases-featured-title">
        <a
          class="cases-featured__media"
          href={caseHref(featured.slug)}
          tabindex="-1"
          aria-hidden="true"
          style={
            featured.heroImage.asset?.metadata?.lqip
              ? `background-image: url(${featured.heroImage.asset.metadata.lqip})`
              : undefined
          }
        >
          <img
            src={urlFor(featured.heroImage).width(960).url()}
            srcset={srcsetFor(featured.heroImage, [640, 960, 1280, 1920])}
            sizes="(width < 64rem) 100vw, 50vw"
            alt=""
          />
        </a>
        <div class="cases-featured__text">
          <p class="cases-meta">{meta(featured)}</p>
          <h2 class="cases-featured__title" id="cases-featured-title">
            <a href={caseHref(featured.slug)}>{featured.title}</a>
          </h2>
          <p>{featured.lead}</p>
          {featured.figure?.value && (
            <p class="cases-featured__figure">
              <strong>{featured.figure.value}</strong>
              <span>{featured.figure.label}</span>
            </p>
          )}
          <a class="cases-button cases-button--primary" href={caseHref(featured.slug)}>
            Читати кейс
          </a>
        </div>
      </article>
    ) : (
      <p class="cases-empty">Кейси з’являться тут незабаром.</p>
    )}

    <!-- ═══ Every other case: wide rows, photo and text alternating sides ═══ -->
    {rest.length > 0 && (
      <section class="cases-all" aria-labelledby="cases-all-title">
        <h2 class="cases-all__title" id="cases-all-title">
          Усі кейси
        </h2>
        {rest.map((c) => (
          <article class="cases-row">
            <a
              class="cases-row__media"
              href={caseHref(c.slug)}
              tabindex="-1"
              aria-hidden="true"
              style={
                c.heroImage.asset?.metadata?.lqip
                  ? `background-image: url(${c.heroImage.asset.metadata.lqip})`
                  : undefined
              }
            >
              <img
                src={urlFor(c.heroImage).width(800).height(500).fit("crop").url()}
                srcset={srcsetFor(c.heroImage, [480, 800, 1200], 16 / 10)}
                sizes="(width < 64rem) 100vw, 50vw"
                alt=""
                loading="lazy"
              />
            </a>
            <div class="cases-row__text">
              <p class="cases-meta">{meta(c)}</p>
              <h3 class="cases-row__title">
                <a href={caseHref(c.slug)}>{c.title}</a>
              </h3>
              <p>{c.lead}</p>
              <a class="cases-button cases-button--outline" href={caseHref(c.slug)}>
                Читати кейс
              </a>
            </div>
          </article>
        ))}
      </section>
    )}
  </div>

  <!-- ═══ The founders, with booking a call in place ═══ -->
  <FoundersCta
    finding="case-studies"
    title="Впізнали свою компанію? <strong>Розберімо її</strong> з&nbsp;тими, хто вів ці діагностики."
    lead="Олена й&nbsp;Сергій особисто ведуть кожну діагностику ATLAS. Оберіть зручний час для 30‑хвилинної розмови."
  />
</FindingsLayout>

<style>
  .cases-empty {
    color: var(--ink-soft);
    font-size: var(--text-body);
  }
  .cases-intro {
    max-width: var(--span-2);
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }
  .cases {
    display: grid;
    row-gap: var(--space-3xl);
    padding-bottom: var(--space-3xl);
  }
  .cases a {
    color: inherit;
    text-decoration-line: none;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  .cases :is(.cases-featured__title, .cases-row__title) a:hover {
    text-decoration-line: underline;
  }
  .cases p {
    margin: 0;
  }
  .cases-meta {
    color: var(--ink-soft);
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }
  /* Sanity's blurred preview (LQIP) shows until the photo loads */
  .cases :is(.cases-featured__media, .cases-row__media) {
    display: block;
    overflow: hidden;
    border-radius: 6px; /* as the carousels' cards */
    background: var(--c-night) center / cover no-repeat;
  }
  .cases :is(.cases-featured__media, .cases-row__media) img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }
  .cases :is(.cases-featured__media, .cases-row__media):hover img {
    transform: scale(1.03);
  }

  /* ---------- The featured case: photo beside a navy panel ---------- */
  .cases-featured {
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    border-radius: 6px;
    background: var(--c-hero);
    color: var(--c-cream);
  }
  /* the photo covers its half of the panel, however tall the text makes it */
  .cases .cases-featured__media {
    position: relative;
    min-height: 100%;
    border-radius: 0;
  }
  .cases .cases-featured__media img {
    position: absolute;
    inset: 0;
  }
  .cases-featured__text {
    display: grid;
    align-content: center;
    justify-items: start;
    row-gap: var(--space-md);
    padding: var(--space-2xl);
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }
  .cases-featured .cases-meta {
    color: rgb(237 233 222 / 0.7);
  }
  .cases-featured__title {
    margin: 0;
    color: var(--c-white);
    font-family: var(--font-display);
    font-size: var(--text-heading);
    font-weight: 600;
    line-height: var(--leading-heading);
  }
  .cases-featured__figure {
    display: grid;
    row-gap: var(--space-xs);
    width: 100%;
    padding-top: var(--space-md);
    border-top: 1px solid rgb(237 233 222 / 0.15);
  }
  .cases-featured__figure strong {
    color: var(--c-white);
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 600;
    line-height: 1;
  }
  .cases-featured__figure span {
    color: rgb(237 233 222 / 0.7);
    font-size: var(--text-small);
  }

  /* ---------- Every other case: alternating rows ---------- */
  .cases-all {
    display: grid;
    row-gap: var(--space-2xl);
  }
  .cases-all__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 600;
    line-height: var(--leading-title);
  }
  .cases-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: calc(var(--col-gap) * 2);
    align-items: center;
  }
  /* every second row puts its photo on the right */
  .cases-row:nth-of-type(even) .cases-row__media {
    order: 2;
  }
  .cases .cases-row__media {
    aspect-ratio: 16 / 10;
  }
  .cases-row__text {
    display: grid;
    justify-items: start;
    row-gap: var(--space-md);
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }
  .cases-row__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 600;
    line-height: var(--leading-title);
  }

  /* ---------- Buttons: blue on navy, outline on the paper ---------- */
  .cases .cases-button {
    display: inline-flex;
    align-items: center;
    min-height: calc(52 * var(--px));
    padding: 0 var(--space-lg);
    border: 2px solid currentColor;
    border-radius: 999px;
    font-size: var(--text-small);
    font-weight: 500;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .cases .cases-button--primary {
    border-color: var(--c-primary);
    background: var(--c-primary);
    color: var(--c-on-primary);
  }
  .cases .cases-button--primary:hover {
    border-color: var(--c-primary-hover);
    background: var(--c-primary-hover);
  }
  .cases .cases-button--outline:hover {
    background: var(--c-hero);
    border-color: var(--c-hero);
    color: var(--c-white);
  }
  .cases .cases-button:focus-visible {
    outline: 3px solid var(--c-accent);
    outline-offset: 3px;
  }

  @media (width < 64rem) {
    .cases {
      row-gap: 64px;
      padding-bottom: 64px;
    }
    .cases-featured,
    .cases-row {
      grid-template-columns: 1fr;
    }
    .cases .cases-featured__media {
      aspect-ratio: 4 / 3;
    }
    .cases-featured__text {
      padding: 24px;
    }
    .cases-row {
      row-gap: 20px;
    }
    .cases-row:nth-of-type(even) .cases-row__media {
      order: 0;
    }
    .cases .cases-button {
      min-height: 48px;
    }
  }
</style>
