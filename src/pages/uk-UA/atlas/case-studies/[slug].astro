---
import { getRelativeLocaleUrl } from "astro:i18n";
import { PortableText } from "astro-portabletext";
import Base from "../../../../layouts/Base.astro";
import Footer from "../../../../components/Footer.astro";
import Crumb from "../../../../components/findings/Crumb.astro";
import FindingsToc from "../../../../components/findings/FindingsToc.astro";
import TocCta from "../../../../components/findings/TocCta.astro";
import FoundersCta from "../../../../components/findings/FoundersCta.astro";
import Carousel, { type Teaser } from "../../../../components/ui/Carousel.astro";
import { commissionedByNames, industryCompany, industryNames, maturityFields } from "../../../../data/case-studies";
import { cases as placeholderCases } from "../../../../data/testimonials";
import { enablerNames } from "../../../../data/enablers";
import { sanityClient } from "../../../../sanity/client";
import { srcsetFor, urlFor } from "../../../../sanity/image";
import { CASE_STUDY_QUERY, CASE_STUDY_SLUGS_QUERY, CASE_STUDY_TEASERS_QUERY } from "../../../../sanity/queries";

// A case study (DAA-230), after the mockup "Шаблон сторінки кейсу", in the findings pages' language: the
// breadcrumb and title over the faded hero image with the client's profile beside them, the key figures, then
// the story on the left two thirds with "on this page" (the findings pages' own) and its call to action on the
// right; the founders' block (booking a call) and the other cases below. Content: Sanity's "Case Studies"
// (`caseStudy`); a section without content is left out, and so is its entry in "on this page".

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch(CASE_STUDY_SLUGS_QUERY);
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const study = await sanityClient.fetch(CASE_STUDY_QUERY, { slug });
if (!study) throw new Error(`No case study with the slug "${slug}"`);

const locale = Astro.currentLocale ?? "uk-UA";
const url = (path: string) => getRelativeLocaleUrl(locale, path, { normalizeLocale: false });

const hero = study.heroImage;
const lqip = hero.asset?.metadata?.lqip;

const profile = [
  { label: "Галузь", value: industryNames[study.industry] },
  { label: "Розмір", value: study.companySize },
  { label: "Ринок", value: study.market },
  { label: "Замовник", value: study.commissionedBy ? commissionedByNames[study.commissionedBy] : null },
  { label: "Тривалість", value: study.duration },
  { label: "Рік", value: study.year ? String(study.year) : null },
].filter((p): p is { label: string; value: string } => Boolean(p.value));

// the maturity profile, highest first; the scale runs 1–5 and the marker is "Визначений" (3,0)
const scores = study.maturity
  ? (
      Object.entries(maturityFields) as [
        keyof typeof maturityFields,
        (typeof maturityFields)[keyof typeof maturityFields],
      ][]
    )
      .map(([field, enabler]) => [enabler, study.maturity![field]] as const)
      .filter((pair): pair is [(typeof pair)[0], number] => typeof pair[1] === "number")
      .sort((a, b) => b[1] - a[1])
  : [];
const DEFINED = 3;
const pct = (v: number) => `${((v / 5) * 100).toFixed(1)}%`;
const fmt = (v: number) => v.toFixed(1).replace(".", ",");

const testimonial = study.testimonial?.quote ? study.testimonial : null;
// named only with the client's written consent; otherwise "CEO, IT-сервісна компанія"
const testimonialAuthor = testimonial
  ? testimonial.showName && testimonial.name
    ? [testimonial.name, testimonial.role].filter(Boolean).join(", ")
    : `${testimonial.role || "Керівник"}, ${industryCompany[study.industry]}`
  : "";

const sections = {
  context: Boolean(study.context?.length),
  process: Boolean(study.phases?.length || study.phasesText?.length),
  findings: Boolean(study.conclusions?.length || study.findingsIntro),
  maturity: scores.length > 0,
  roadmap: study.horizons?.length === 3,
  changes: Boolean(study.changes?.length || study.changesText?.length),
  testimonial: Boolean(testimonial),
};
const toc = [
  { id: "context", label: "Контекст: з чим прийшов клієнт" },
  { id: "process", label: "Як проходила діагностика" },
  { id: "findings", label: "Що знайшла діагностика" },
  { id: "maturity", label: "Профіль зрілості за складовими" },
  { id: "roadmap", label: "Дорожня карта зростання" },
  { id: "changes", label: "Що змінилося" },
  { id: "testimonial", label: "Відгук клієнта" },
].filter((item) => sections[item.id as keyof typeof sections]);

// other cases: picked in the Studio, else the latest others; until there are any, the ATLAS page's examples
type CaseTeaser = {
  title: string;
  slug: string;
  cardTag: string | null;
  industry: keyof typeof industryNames;
  companySize: string;
  heroImage: { asset: { _id: string } | null } & Record<string, unknown>;
};
// a referenced case that no longer resolves (unpublished in a release) comes back as null: leave it out
const picked = ((study.otherCases ?? []) as (CaseTeaser | null)[]).filter((c): c is CaseTeaser => c !== null);
const latest = picked.length
  ? []
  : ((await sanityClient.fetch(CASE_STUDY_TEASERS_QUERY)) as CaseTeaser[]).filter((c) => c.slug !== study.slug);
// card titles go to the carousel as HTML, so the plain-text titles from Sanity are escaped
const escape = (text: string) => text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const toTeaser = (c: CaseTeaser): Teaser => ({
  image: {
    src: urlFor(c.heroImage).width(640).height(640).fit("crop").url(),
    srcset: srcsetFor(c.heroImage, [320, 480, 640, 800], 1),
  },
  tag: c.cardTag || `${industryNames[c.industry]} · ${c.companySize}`,
  title: escape(c.title),
  href: url(`atlas/case-studies/${c.slug}`),
});
const others = [...picked, ...latest].filter((c) => c.heroImage?.asset).map(toTeaser);
const otherTeasers = others.length ? others : placeholderCases;
---

<Base
  title={`${study.seo_title || study.title} | Кейси Daat`}
  description={study.seo_description || study.lead}
  noindex={Boolean(study.no_index)}
>
  <main id="main" class="case">
    <!-- ═══ Hero: the breadcrumb, title and lead; the client's profile beside them ═══ -->
    <header class="case-hero">
      <!-- the artwork fades into the paper, as on a finding's page; its blurred preview shows until it loads -->
      <div class="case-hero__art" aria-hidden="true" style={lqip ? `background-image: url(${lqip})` : undefined}>
        <img
          src={urlFor(hero).width(1440).url()}
          srcset={srcsetFor(hero, [640, 960, 1440, 1920, 2400])}
          sizes="100vw"
          alt=""
          fetchpriority="high"
        />
      </div>
      <div class="wrap case-hero__inner">
        <div class="case-hero__main">
          <Crumb href={url("atlas/case-studies")} label="Кейси" />
          <h1 class="case-hero__title">{study.title}</h1>
          <p class="case-hero__lead">{study.lead}</p>
        </div>
        {profile.length > 0 && (
          <aside class="case-profile" aria-labelledby="case-profile-title">
            <h2 class="case-profile__title" id="case-profile-title">
              Профіль клієнта
            </h2>
            <dl>
              {profile.map((p) => (
                <div>
                  <dt>{p.label}</dt>
                  <dd>{p.value}</dd>
                </div>
              ))}
            </dl>
          </aside>
        )}
      </div>
    </header>

    <!-- ═══ Key figures, as the About page's "Daat у цифрах" ═══ -->
    {study.figures && study.figures.length > 0 && (
      <div class="wrap">
        <ul class="case-figures" style={`--n: ${study.figures.length}`}>
          {study.figures.map((f) => (
            <li>
              <span>{f.label}</span>
              <strong>{f.value}</strong>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- ═══ The story, with "on this page" and its call to action beside it ═══ -->
    <div class="wrap case-layout">
      <article class="case-body">
        {sections.context && (
          <section id="context" class="case-section">
            <h2>Контекст: з чим прийшов клієнт</h2>
            <PortableText value={study.context!} />
            {study.contextQuote && (
              <blockquote class="case-quote">
                <p>«{study.contextQuote}»</p>
              </blockquote>
            )}
          </section>
        )}

        {sections.process && (
          <section id="process" class="case-section">
            <h2>Як проходила діагностика</h2>
            {study.phases && study.phases.length > 0 && (
              <ol class="case-phases" style={`--n: ${study.phases.length}`}>
                {study.phases.map((ph) => (
                  <li>
                    <p class="case-phases__label">{ph.label}</p>
                    <h3>{ph.title}</h3>
                    {ph.text && <p>{ph.text}</p>}
                  </li>
                ))}
              </ol>
            )}
            {study.phasesText && <PortableText value={study.phasesText} />}
          </section>
        )}

        {sections.findings && (
          <section id="findings" class="case-section">
            <h2>Що знайшла діагностика</h2>
            {study.findingsIntro && <p>{study.findingsIntro}</p>}
            {study.conclusions && study.conclusions.length > 0 && (
              <ol class="case-conclusions">
                {study.conclusions.map((item, i) => {
                  const label = item.findingLabel || item.finding?.title;
                  return (
                    <li>
                      <p class="case-conclusions__label">Висновок {i + 1}</p>
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                      {label && (
                        <p class="case-conclusions__finding">
                          Знахідка аудиту:{" "}
                          {item.finding?.slug ? (
                            <a href={url(`atlas/findings/${item.finding.slug}`)}>{label}</a>
                          ) : (
                            <span>{label}</span>
                          )}
                        </p>
                      )}
                    </li>
                  );
                })}
              </ol>
            )}
          </section>
        )}

        {sections.maturity && (
          <section id="maturity" class="case-section">
            <h2>Профіль зрілості за складовими</h2>
            <table class="case-table case-maturity">
              <thead>
                <tr>
                  <th scope="col">Складова зрілості</th>
                  <th scope="col">Індекс</th>
                  <th scope="col">1–5 · риска&nbsp;— «Визначений» (3,0)</th>
                </tr>
              </thead>
              <tbody>
                {scores.map(([enabler, value]) => (
                  <tr>
                    <th scope="row">{enablerNames[enabler]}</th>
                    <td class="case-maturity__value">{fmt(value)}</td>
                    <td>
                      <span class="case-maturity__bar" style={`--v: ${pct(value)}; --mark: ${pct(DEFINED)}`} />
                    </td>
                  </tr>
                ))}
              </tbody>
              {typeof study.maturity?.total === "number" && (
                <tfoot>
                  <tr>
                    <th scope="row">Загальний індекс зрілості</th>
                    <td class="case-maturity__value">{fmt(study.maturity.total)}</td>
                    <td>{study.maturity.totalNote}</td>
                  </tr>
                </tfoot>
              )}
            </table>
          </section>
        )}

        {sections.roadmap && (
          <section id="roadmap" class="case-section case-roadmap">
            <h2>Дорожня карта зростання</h2>
            {study.roadmapLead && <p>{study.roadmapLead}</p>}
            <div class="audience-tabs case-roadmap__tabs" role="tablist" aria-label="Горизонти дорожньої карти">
              {study.horizons!.map((h, i) => (
                <button
                  class="audience-tab"
                  type="button"
                  role="tab"
                  id={`case-tab-${i}`}
                  aria-controls={`case-panel-${i}`}
                  aria-selected={i === 0 ? "true" : "false"}
                  tabindex={i === 0 ? 0 : -1}
                >
                  <span class="audience-tab__title nowrap">{h.tab}</span>
                </button>
              ))}
            </div>
            <div class="case-horizons">
              {study.horizons!.map((h, i) => (
                <div
                  class:list={["case-horizon", { "is-active": i === 0 }]}
                  role="tabpanel"
                  id={`case-panel-${i}`}
                  aria-labelledby={`case-tab-${i}`}
                  aria-hidden={i === 0 ? undefined : "true"}
                >
                  <p class="case-horizon__label">{h.label}</p>
                  <h3>{h.title}</h3>
                  {h.text && <p>{h.text}</p>}
                </div>
              ))}
            </div>
            <a class="case-roadmap__more" href={`${url("atlas")}#roadmap`}>
              Як будується дорожня карта ATLAS&nbsp;→
            </a>
          </section>
        )}

        {sections.changes && (
          <section id="changes" class="case-section">
            <h2>Що змінилося</h2>
            {study.changes && study.changes.length > 0 && (
              <table class="case-table case-changes">
                <thead>
                  <tr>
                    <th scope="col">Показник</th>
                    <th scope="col">До</th>
                    <th scope="col">Після</th>
                    <th scope="col">Період</th>
                  </tr>
                </thead>
                <tbody>
                  {study.changes.map((r) => (
                    <tr>
                      <th scope="row">{r.metric}</th>
                      <td>{r.before}</td>
                      <td class="case-changes__after">{r.after}</td>
                      <td>{r.period}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
            {study.changesText && <PortableText value={study.changesText} />}
          </section>
        )}

        {testimonial && (
          <section id="testimonial" class="case-section">
            <h2>Відгук клієнта</h2>
            <!-- TODO: the client's video (where videos live is still to be decided); a placeholder until then -->
            <div class="case-video" role="img" aria-label="Відеовідгук клієнта (буде додано)">
              <span class="case-video__note">Відеовідгук · 16:9</span>
              <span class="case-video__play" aria-hidden="true" />
            </div>
            <blockquote class="case-testimonial">
              <p>«{testimonial.quote}»</p>
              <footer>{testimonialAuthor}</footer>
            </blockquote>
            {testimonial.transcript && testimonial.transcript.length > 0 && (
              <details class="case-transcript">
                <summary>Читати транскрипт</summary>
                <PortableText value={testimonial.transcript} />
              </details>
            )}
          </section>
        )}
      </article>

      <FindingsToc items={toc}>
        <TocCta title="Схожа ситуація?" />
      </FindingsToc>
    </div>

    <!-- ═══ The founders, with booking a call in place ═══ -->
    <FoundersCta
      finding={`case:${study.slug}`}
      title="Впізнали схожу ситуацію? <strong>Розберімо вашу</strong> з&nbsp;тими, хто вів цю діагностику."
      lead="Олена й&nbsp;Сергій особисто ведуть кожну діагностику ATLAS. За 30&nbsp;хвилин розберемо, чи потрібна вона вам&nbsp;— і&nbsp;з&nbsp;чого почати."
    />

    <!-- ═══ Other cases: the ATLAS page's cases carousel ═══ -->
    <section class="case-others" aria-labelledby="case-others-title">
      <div class="wrap">
        <h2 class="case-others__title" id="case-others-title">
          Інші кейси
        </h2>
        <Carousel
          label="Інші кейси"
          items={otherTeasers}
          more="Читати кейс"
          prevLabel="Попередні кейси"
          nextLabel="Наступні кейси"
        />
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  // Roadmap tabs (arrow keys move between them); clicking a column selects it too. All columns stay visible,
  // the selected one at full strength.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>(".case-roadmap [role='tab']")];
  const panelOf = (tab: HTMLButtonElement) => document.getElementById(tab.getAttribute("aria-controls")!)!;
  const select = (tab: HTMLButtonElement, focus = false) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute("aria-selected", String(on));
      t.tabIndex = on ? 0 : -1;
      panelOf(t).classList.toggle("is-active", on);
      if (on) panelOf(t).removeAttribute("aria-hidden");
      else panelOf(t).setAttribute("aria-hidden", "true");
    }
    if (focus) tab.focus();
  };
  for (const tab of tabs) {
    tab.addEventListener("click", () => select(tab));
    tab.addEventListener("keydown", (e) => {
      const i = tabs.indexOf(tab);
      const next = ({ ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 } as Record<string, number>)[
        e.key
      ];
      if (next === undefined) return;
      e.preventDefault();
      select(tabs[(next + tabs.length) % tabs.length], true);
    });
    panelOf(tab).addEventListener("click", () => select(tab));
  }
</script>

<style>
  /* the findings pages' lighter paper */
  :global(body:has(.case)) {
    --c-paper: color-mix(in srgb, var(--color-paper) 50%, var(--color-white));
  }
  /* the findings pages' ground and inks (FindingsLayout's .finding-page), so "on this page" reads the same */
  .case {
    --ink-soft: rgb(28 38 50 / 0.72);
    --rule: rgb(28 38 50 / 0.12);
    --tint: color-mix(in srgb, var(--c-hero) 4%, var(--c-paper));
    background: var(--c-paper);
    color: var(--c-hero);
  }
  .case-body,
  .case-hero {
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }
  .case p,
  .case-body :global(p) {
    margin: 0; /* the sections' grids space the paragraphs, Portable Text's included */
  }
  .case h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-heading);
    font-weight: 500;
    line-height: var(--leading-heading);
  }
  .case h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lead);
    font-weight: 600;
    line-height: var(--leading-title);
  }
  /* links in the story and the profile */
  .case-body :global(a),
  .case-profile a {
    color: inherit;
    text-decoration-line: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    transition: color 0.2s ease;
  }
  .case-body :global(a:hover) {
    color: var(--c-primary);
  }

  /* ---------- Hero ---------- */
  /* As a finding's: the breadcrumb starts well below the bar, clear of the hanging logo */
  .case-hero {
    position: relative;
    overflow: hidden;
  }
  .case-hero__art,
  .case-hero__art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* the blurred preview (Sanity's LQIP) shows until the artwork loads */
  .case-hero__art {
    background: center / cover no-repeat;
  }
  .case-hero__art::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--c-paper) 20%, transparent),
      color-mix(in srgb, var(--c-paper) 72%, transparent) 55%,
      var(--c-paper)
    );
  }
  .case-hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: var(--span-2) 1fr;
    column-gap: calc(var(--col-gap) * 2);
    align-items: start;
    padding-top: calc(200 * var(--px));
    padding-bottom: var(--space-2xl);
  }
  .case-hero__main {
    display: grid;
    row-gap: var(--space-xl);
  }
  .case-hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 600;
    line-height: var(--leading-display);
    font-feature-settings: "dlig" 1;
  }
  .case-hero__lead {
    margin-top: calc(-1 * var(--space-sm)) !important; /* closer to the title than the breadcrumb is */
    font-size: var(--text-lead);
  }
  /* the client's profile: on the ATLAS page methodology's navy */
  .case-profile {
    padding: var(--space-lg);
    background: var(--c-hero);
    color: var(--c-cream);
  }
  .case .case-profile__title {
    color: var(--c-white);
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 600;
    line-height: var(--leading-small);
  }
  .case-profile dl {
    margin: var(--space-sm) 0 0;
  }
  .case-profile dl div {
    display: grid;
    row-gap: calc(2 * var(--px));
    padding: var(--space-sm) 0;
    border-top: 1px solid rgb(237 233 222 / 0.15);
  }
  .case-profile dl div:last-child {
    padding-bottom: 0;
  }
  .case-profile dt {
    color: rgb(237 233 222 / 0.6);
    font-size: calc(14 * var(--px)); /* as the image labels */
    line-height: var(--leading-small);
  }
  .case-profile dd {
    margin: 0;
    color: var(--c-white);
    font-size: var(--text-small);
    font-weight: 500;
    line-height: var(--leading-small);
  }
  .case-profile a:hover {
    color: var(--c-accent);
  }

  /* ---------- Key figures: the About page's cards ---------- */
  /* one column per figure (up to four), so there are no empty cells */
  .case-figures {
    display: grid;
    grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .case-figures li {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-lg);
    background: var(--c-paper);
  }
  .case-figures span {
    color: var(--ink-soft);
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }
  .case-figures strong {
    margin-top: auto;
    padding-top: var(--space-md);
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  /* ---------- Story and "on this page": the findings pages' grid ---------- */
  .case-layout {
    display: grid;
    grid-template-columns: var(--span-2) 1fr;
    column-gap: calc(var(--col-gap) * 2);
    padding-block: var(--space-3xl);
  }
  .case-body {
    display: grid;
    row-gap: var(--space-3xl);
    min-width: 0;
  }
  .case-section {
    display: grid;
    row-gap: var(--space-md);
    scroll-margin-top: var(--space-xl);
  }
  .case-section > h2 {
    margin-bottom: var(--space-xs);
  }
  .case-quote {
    margin: var(--space-sm) 0 0;
    padding-left: var(--space-md);
    border-left: 3px solid var(--c-primary);
    font-family: var(--font-display);
    font-size: var(--text-lead);
    font-weight: 500;
