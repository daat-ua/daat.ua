---
import { getRelativeLocaleUrl } from "astro:i18n";

// Cookie notice (DAA-217), carried over from the previous site (src/components/layout/CookieConsent.astro): a
// pill at the bottom right with one "OK". It slides in a moment after the page loads and, once accepted, never
// shows again in that browser. The key is the previous site's, so visitors who accepted there aren't asked again.

const policyHref = `${getRelativeLocaleUrl(Astro.currentLocale ?? "uk-UA", "privacy-policy", { normalizeLocale: false })}#cookies`;
---

<div class="cookie-consent" id="cookie-consent" role="region" aria-label="Файли cookie" data-shown="false" hidden>
  <div class="cookie-consent__bar">
    <svg class="cookie-consent__icon" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
      <path d="M164.49,163.51a12,12,0,1,1-17,0A12,12,0,0,1,164.49,163.51Zm-81-8a12,12,0,1,0,17,0A12,12,0,0,0,83.51,155.51Zm9-39a12,12,0,1,0-17,0A12,12,0,0,0,92.49,116.49Zm48-1a12,12,0,1,0,0,17A12,12,0,0,0,140.49,115.51ZM232,128A104,104,0,1,1,128,24a8,8,0,0,1,8,8,40,40,0,0,0,40,40,8,8,0,0,1,8,8,40,40,0,0,0,40,40A8,8,0,0,1,232,128Zm-16.31,7.39A56.13,56.13,0,0,1,168.5,87.5a56.13,56.13,0,0,1-47.89-47.19,88,88,0,1,0,95.08,95.08Z"></path>
    </svg>
    <p class="cookie-consent__text">
      Ми використовуємо аналітичні файли cookie, щоб розуміти, як відвідувачі користуються сайтом.
      <a href={policyHref}>Детальніше</a>
    </p>
    <button class="cookie-consent__ok" type="button">
      OK
    </button>
  </div>
</div>

<script>
  const KEY = "daat-cookies-ok";
  const banner = document.getElementById("cookie-consent");
  const ok = banner?.querySelector<HTMLButtonElement>(".cookie-consent__ok");

  let accepted = false;
  try {
    accepted = localStorage.getItem(KEY) === "1";
  } catch {
    // storage blocked (private mode, site data off): ask, and don't remember
  }

  if (banner && ok && !accepted) {
    banner.hidden = false;
    setTimeout(() => (banner.dataset.shown = "true"), 1200);

    ok.addEventListener("click", () => {
      try {
        localStorage.setItem(KEY, "1");
      } catch {
        // not remembered: it shows again on the next page
      }
      banner.dataset.shown = "false";
      setTimeout(() => banner.remove(), 500);
    });
  }
</script>

<style is:global>
  /* ---------- Cookie notice: a dark pill at the bottom right, above the phones' call bar ---------- */
  .cookie-consent {
    position: fixed;
    z-index: 6; /* above the page and the call bar (5), under the menu dialog (top layer) */
    right: var(--space-lg);
    bottom: calc(var(--space-lg) + env(safe-area-inset-bottom, 0px));
    /* above the finding pages' call bar while it's up (they set --call-bar-space to its height + a gap), but never
       past the top of a short window (zoom, landscape phones): there it covers the bar until OK. In translate, 100%
       is the notice's own height; 24px keeps the 12px phone inset at both ends */
    translate: 0 calc(-1 * max(0px, min(var(--call-bar-space, 0px), 100dvh - 100% - 24px)));
    transition:
      transform 0.5s var(--ease-out),
      opacity 0.4s var(--ease-out),
      translate 0.35s var(--ease-out);
  }
  .cookie-consent[data-shown="false"] {
    opacity: 0;
    pointer-events: none;
    transform: translateY(calc(100% + var(--space-lg)));
  }
  .cookie-consent__bar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-xs) var(--space-xs) var(--space-md);
    border-radius: 999px;
    background: color-mix(in srgb, var(--c-hero) 90%, transparent);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--c-hero) 25%, transparent);
    color: var(--c-white);
    backdrop-filter: blur(12px);
  }
  .cookie-consent__icon {
    flex: none;
    width: calc(32 * var(--px));
    height: calc(32 * var(--px));
    opacity: 0.6;
  }
  .cookie-consent__text {
    max-width: calc(420 * var(--px));
    margin: 0;
    font-size: calc(15 * var(--px));
    line-height: var(--leading-small);
    opacity: 0.85;
  }
  .cookie-consent__text a {
    color: inherit;
    text-decoration-line: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  .cookie-consent__text a:hover {
    color: var(--c-white);
  }
  .cookie-consent__ok {
    flex: none;
    padding: 0.45em 1.15em 0.35em; /* TT Commons sits high */
    border: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--c-white) 15%, transparent);
    color: inherit;
    font: inherit;
    font-size: calc(15 * var(--px));
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.12s ease;
  }
  .cookie-consent__ok:hover {
    background: color-mix(in srgb, var(--c-white) 25%, transparent);
  }
  .cookie-consent__ok:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--c-white) 60%, transparent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-consent {
      transition: opacity 0.2s ease;
    }
    .cookie-consent[data-shown="false"] {
      transform: none;
    }
  }

  @media (width < 64rem) {
    .cookie-consent {
      right: 12px;
      bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      left: 12px;
      max-width: 480px;
      margin-inline: auto;
    }
    .cookie-consent__bar {
      gap: 12px;
      padding: 8px 8px 8px 16px;
    }
    .cookie-consent__icon {
      width: 28px;
      height: 28px;
    }
    .cookie-consent__text {
      max-width: none;
      font-size: 14px;
    }
    .cookie-consent__ok {
      font-size: 15px;
    }
  }
</style>
