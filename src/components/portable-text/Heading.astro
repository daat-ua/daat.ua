---
import type { BlockProps } from "astro-portabletext/types";
import { headingId } from "../../sanity/portable-text";

// h2/h3 from Portable Text, with an id from the heading text for the "on this page" links
type Props = BlockProps;

const { node, index, isInline, ...attrs } = Astro.props;
const Tag = node.style === "h3" ? "h3" : "h2";
---

<Tag id={headingId(node)} {...attrs}>
  <slot />
</Tag>
