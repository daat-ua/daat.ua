---
import { legalLinks, social, type SocialNetwork } from "../data/navigation";
import Logo from "./ui/Logo.astro";

// Simple stroke drawings in the style of the page's icons (TODO: official marks, if wanted)
const ICONS: Record<SocialNetwork, string> = {
  LinkedIn: `<rect x="3" y="3" width="18" height="18" rx="4" /><path d="M8 11v5M8 8v.01M12 16v-5M12 13.5c0-1.5 1-2.5 2.5-2.5S17 12 17 13.5V16" />`,
  Facebook: `<path d="M15.5 3.5H14a4 4 0 0 0-4 4V10H7.5v3H10v7.5h3V13h2.5l.5-3h-3V7.8c0-.6.4-1.3 1.2-1.3h1.3z" />`,
  Instagram: `<rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17.5 6.5v.01" />`,
  YouTube: `<rect x="2.5" y="5" width="19" height="14" rx="4" /><path d="M10 9.5v5l4.5-2.5z" />`,
};
---

<!-- Full width, below the TOC zone. TODO links: legal pages, social profiles and the English version -->
<footer class="footer">
  <div class="wrap">
    <p class="footer__lang">
      <a href="#" aria-current="true" lang="uk">
        UA
      </a>
      <span aria-hidden="true">|</span>
      <a href="#" lang="en">
        EN
      </a>
    </p>
    <div class="footer__main">
      <Logo class="footer__logo" />
      <div class="footer__row">
        <nav class="footer__nav" aria-label="Правова інформація">
          <ul>
            {legalLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="footer__social">
          <span>Ми в соцмережах</span>
          <ul>
            {social.map(({ network, href }) => (
              <li>
                <a href={href} aria-label={network}>
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[network]} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="footer__legal">
        <p>
          <span class="brand">Daat</span>&nbsp;— консалтинг зі стратегії та розвитку{" "}
          <span class="nowrap">IT-компаній</span>. ATLAS&nbsp;— методологія діагностики зростання, розроблена{" "}
          <span class="brand">Daat</span>.
        </p>
        <p>
          Цифри в кейсах і сценаріях на цій сторінці ілюстративні, якщо не зазначено інше. У&nbsp;випадках використання
          NDA, назви компаній клієнтів приховано за їхньою згодою.
        </p>
        <p>
          ©&nbsp;2026 <span class="brand">Daat</span>
        </p>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  /* ---------- Footer: full width, below the TOC zone ---------- */
  .footer {
    --footer-logo: calc(81.19 * var(--px)); /* half the header logo, then 15% larger */
    --footer-gap: var(--space-2xl);
    padding: var(--space-2xl) 0;
    background: var(--c-paper);
    color: var(--c-hero);
    font-size: var(--text-small);
    line-height: var(--leading-body);
  }
  .footer a {
    color: inherit;
  }
  .footer__lang {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-xs);
    margin: 0;
  }
  .footer__lang a[aria-current] {
    font-weight: 600;
  }
  .footer__lang span {
    color: rgb(28 38 50 / 0.4);
  }
  .footer__main {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center; /* the links + social row is centred on the logo */
    column-gap: var(--footer-gap);
    margin-top: var(--space-md);
  }
  .footer__logo {
    display: block;
    width: var(--footer-logo);
  }
  /* links and the social line share one top; together they span the last two columns */
  .footer__row {
    display: grid;
    grid-column: 2 / -1;
    grid-template-columns: subgrid;
    align-items: start;
  }
  .footer__logo img {
    width: 100%;
    height: auto;
  }
  .footer ul {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer__nav ul {
    gap: var(--space-xs) var(--space-lg);
  }
  .footer__nav a {
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    text-decoration-color: rgb(28 38 50 / 0.35);
    transition: text-decoration-color 0.2s ease;
  }
  .footer__nav a:hover,
  .footer__nav a:focus-visible {
    text-decoration-color: currentColor;
  }
  .footer__social {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: calc(
      (var(--text-small) * var(--leading-body) - 44px) / 2
    ); /* the 44px icon targets overhang, so the text lines up with the links */
  }
  .footer__social ul {
    gap: var(--space-sm);
  }
  .footer__social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    transition: background-color 0.2s ease;
  }
  .footer__social a:hover {
    background: rgb(28 38 50 / 0.06);
  }
  .footer__social svg {
    width: calc(24 * var(--px));
    min-width: 22px;
    height: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* the notes sit in the links' column: same start, same width, nothing under the logo */
  .footer__legal {
    grid-column: 2;
    margin-top: var(--space-xl);
    color: rgb(28 38 50 / 0.75);
  }
  .footer__legal p {
    margin: 0;
  }
  .footer__legal p + p {
    margin-top: 0;
  } /* the two notes run on as consecutive lines */
  .footer__legal p:last-child {
    margin-top: var(--space-md);
  }

  @media (width < 64rem) {
    .footer {
      padding: 48px 0;
      --footer-logo: 48.76px;
    }
    .footer__main {
      grid-template-columns: 1fr;
      row-gap: 32px;
      justify-items: start;
    }
    .footer__legal {
      grid-column: auto;
      margin-top: 0;
    }
    .footer__row {
      grid-column: auto;
      grid-template-columns: 1fr;
      row-gap: 32px;
    }
    .footer__social {
      flex-wrap: wrap;
      gap: 8px 16px;
      margin-top: 0;
    }
    .footer__social ul {
      gap: 0;
      margin-left: -10px;
    }
  }
</style>
