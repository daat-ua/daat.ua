---
import { contact } from "../../../data/navigation";
import { Image, Picture } from "astro:assets";
import arrow from "../../../assets/icons/icon-arrow-up-right.svg";
import plant from "../../../assets/icons/icon-plant.svg";
import photo from "../../../assets/images/hero-photo.webp";
import { clients } from "../../../data/hero";
---

<section class="hero">
  <div class="hero__photo-clip" aria-hidden="true">
    <!-- the LCP image: modern formats, sized to the 1344.5px (desktop) / 150vw (phone) box, loaded first -->
    <Picture
      class="hero__photo"
      src={photo}
      alt=""
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={[640, 960, 1344, 1800, 2400, 2880]}
      sizes="(width < 64rem) 150vw, 93.37vw"
      loading="eager"
      fetchpriority="high"
      layout="none"
    />
  </div>

  <div class="wrap">
    <h1 class="hero__title">
      Ваша компанія здатна на <!-- the arrow right after the word, no space: the icon's own inner padding is the gap -->
      <!-- prettier-ignore -->
      <span class="nowrap">більше<Image class="hero__arrow" src={arrow} alt="" width={24} height={24} layout="none" /></span>
      <strong>
        ATLAS покаже, що стримує її{" "}
        <span class="nowrap">
          зростання
          <Image src={plant} alt="" width={126} height={126} layout="none" />
        </span>
      </strong>
    </h1>

    <p class="hero__lead">
      Ми виявляємо, що стримує розвиток вашої компанії, допомагаємо покращити delivery та отримати перші результати вже
      за <span class="nowrap">4–5 тижнів</span>.
    </p>

    <div class="clients">
      <p class="clients__label">Ми пишаємося нашими клієнтами</p>
      <ul class="clients__logos">
        {clients.map((c) => (
          <li>
            <Image src={c.logo} alt={c.name} layout="none" />
          </li>
        ))}
      </ul>
    </div>

    <div class="cta">
      <a class="btn btn--primary" href={contact.href}>
        Записатися на діагностичний дзвінок
      </a>
      <a class="btn btn--secondary" href="#deliverables">
        Які результати ви отримаєте?{" "}
        <svg class="btn__icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18 9.00005C18 9.00005 13.5811 15 12 15C10.4188 15 6 9 6 9" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style is:global>
  /* ---------- Hero ---------- */
  .hero {
    --hero-gap: calc(20 * var(--px)); /* margin below the hero */
    position: relative;
    margin-bottom: var(--hero-gap);
    z-index: 3; /* buttons overhang onto the blue section below */
  }
  .hero__photo-clip {
    position: absolute;
    inset: 0 0 calc(var(--overhang) - var(--hero-gap)) 0; /* the dark band runs to where the blue section starts */
    overflow: hidden;
    background: var(--c-hero);
    pointer-events: none;
  }
  .hero__photo {
    position: absolute;
    left: calc(508 * var(--px));
    bottom: calc(-59.5 * var(--px)); /* Figma crop: the dark band cuts the photo 59.5 above its bottom edge */
    width: calc(1344.5 * var(--px));
    height: calc(896.5 * var(--px));
    max-width: none;
    object-fit: cover;
    opacity: 0.45;
  }
  .hero .wrap {
    z-index: 1;
    padding-top: calc(var(--space-3xl) + var(--space-2xl)); /* 160 at 1440 */
  }
  .hero__title {
    max-width: calc(832 * var(--px));
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-display);
    line-height: var(--leading-display);
    font-weight: 300;
    font-feature-settings: "dlig" 1;
  }
  .hero__title strong {
    font-weight: var(--weight-emphasis);
  }
  .hero__title img {
    display: inline-block;
    width: 1em;
    height: 1em;
    margin-left: 0.2em;
    vertical-align: -0.19em;
  }
  /* the arrow's drawing starts a quarter into its box: pulled in so the visible gap is a letter's width */
  .hero__title .hero__arrow {
    margin-left: -0.1em;
  }
  .hero__lead {
    max-width: var(--span-2);
    margin: var(--space-2xl) 0 0;
    color: var(--c-cream);
    font-size: var(--text-lead);
    line-height: var(--leading-body);
  }
  .hero__lead strong {
    font-weight: 600;
  }
  .hero__divider {
    width: var(--span-2);
    max-width: 100%;
    height: calc(2 * var(--px));
    margin-top: var(--space-2xl);
  }
  .theses {
    display: grid;
    grid-template-columns: repeat(2, var(--col));
    gap: var(--space-xl) var(--col-gap);
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
    font-feature-settings: "dlig" 1;
  }
  .theses dt {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-title);
    line-height: var(--leading-title);
  }
  .theses dd {
    margin: var(--space-sm) 0 0;
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }
  .clients {
    display: grid;
    row-gap: var(--space-md);
    margin: var(--space-2xl) 0;
    padding-bottom: calc(2 * var(--space-2xl)); /* 128 at 1440: the logos set apart from the buttons below */
  }
  .clients__label {
    margin: 0;
    color: var(--c-cream);
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }
  .clients__logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .clients__logos img {
    height: calc(25.152 * var(--px));
    width: auto;
  }
  .cta {
    position: relative;
    display: flex;
    margin-top: var(--space-2xl);
  }

  @media (width < 64rem) {
    .hero {
      --hero-gap: 20px;
    }
    /* the call to action comes right after the lead, so it's on the first screen of a phone (DAA-246); the
       client logos follow it. Only the order on screen changes: the logos hold no links, so focus order is unaffected */
    .hero .wrap {
      display: flex;
      flex-direction: column;
      padding-top: 252px; /* 100px more than the header needs: the founders' faces sit above the headline */
      padding-bottom: 40px;
    }
    .hero__title {
      max-width: 640px;
    }
    .hero__lead {
      margin-top: 40px;
    }
    /* the founders at the top, both in frame, their faces above the headline; the photo fades out below their
       shoulders, and a gradient darkens the band behind the text from the headline down (DAA-246) */
    .hero__photo {
      left: 50%;
      top: 40px;
      bottom: auto;
      width: 150vw;
      height: auto;
      aspect-ratio: 1344.5 / 896.5;
      opacity: 0.9;
      transform: translateX(-50%);
      mask-image: linear-gradient(to bottom, #000 28%, transparent 66%);
    }
    .hero__photo-clip::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgb(28 38 50 / 0) 0%,
        rgb(28 38 50 / 0.15) 18%,
        rgb(28 38 50 / 0.78) 32%,
        var(--c-hero) 52%
      );
    }
    .hero__divider {
      margin-top: 40px;
    }
    .theses {
      grid-template-columns: 1fr;
      row-gap: 32px;
      margin-top: 36px;
    }
    .clients {
      order: 2;
      grid-template-columns: 1fr;
      row-gap: 24px;
      margin-top: 48px;
    }
    .clients__logos {
      gap: 20px 28px;
    }
    .clients__logos img {
      height: 18.662px; /* 20% larger than the first cut (15.552px), so the logos read on a phone */
    }
    .cta {
      order: 1;
      flex-direction: column;
      align-items: stretch;
      max-width: 480px;
      margin-top: 40px;
    }
  }
</style>
