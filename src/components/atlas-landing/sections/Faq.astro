---
import { faq } from "../../../data/faq";
---

<section class="for-whom faq" id="faq">
  <div class="wrap">
    <h2 class="section-title">
      <strong>Питання,</strong> які власники ставлять перед діагностикою
    </h2>
    <!-- every answer open as rendered (and without script); on phones the script folds all but the first, so the
         questions can be skimmed (DAA-246). Desktop shows them all, as before -->
    <div class="faq__list">
      {faq.map((item) => (
        <details class="faq__item" open>
          <summary class="faq__q" set:html={item.q} />
          <div class="faq__a" set:html={item.a} />
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  const items = [...document.querySelectorAll<HTMLDetailsElement>(".faq__item")];
  const phone = matchMedia("(width < 64rem)");
  const apply = () => {
    items.forEach((d, i) => {
      d.open = !phone.matches || i === 0;
      // desktop: the questions are headings, not controls
      d.querySelector("summary")!.tabIndex = phone.matches ? 0 : -1;
    });
  };
  apply();
  phone.addEventListener("change", apply);
  // desktop keeps every answer open, whatever a key or click on the question does
  for (const d of items) d.addEventListener("toggle", () => !phone.matches && !d.open && (d.open = true));
</script>

<style is:global>
  /* ---------- FAQ: two columns, typography of the roadmap's revenue table ---------- */
  .faq__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--space-2xl);
    width: var(--span-3);
    max-width: 100%;
    margin: var(--space-xl) 0 0;
  }
  .faq__item {
    padding: var(--space-md) 0;
    border-top: 1px solid rgb(237 233 222 / 0.12);
    font-size: var(--text-small);
  }
  .faq__q {
    display: block;
    list-style: none;
    cursor: default;
    /* same as the horizon column h4 */
    margin: 0;
    color: var(--c-white);
    font-size: var(--text-body);
    font-weight: 600;
    line-height: 1.3;
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__a {
    margin: var(--space-xs) 0 0;
    color: rgb(237 233 222 / 0.75);
    line-height: var(--leading-body);
  }
  .faq__item a {
    /* vertical padding on an inline link widens its target to 24px (WCAG 2.5.8) without moving a line (DAA-246) */
    padding-block: 4px;
    color: var(--c-cream);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: rgb(237 233 222 / 0.45);
    transition: text-decoration-color 0.2s ease;
  }
  .faq__item a:hover {
    text-decoration-color: currentColor;
  }

  @media (width < 64rem) {
    /* the slice is too narrow for a logo */
    .faq__list {
      grid-template-columns: 1fr;
      margin-top: 32px;
    }
    /* phones: each question opens its answer; the row is a 44px target, a chevron shows the state */
    .faq__item {
      padding: 0;
    }
    .faq__q {
      position: relative;
      min-height: 44px;
      padding: var(--space-md) 36px var(--space-md) 0;
      cursor: pointer;
    }
    .faq__q::after {
      content: "";
      position: absolute;
      top: calc(var(--space-md) + 0.2em);
      right: 6px;
      width: 9px;
      height: 9px;
      border-right: 1.5px solid currentColor;
      border-bottom: 1.5px solid currentColor;
      transform: rotate(45deg);
      transition: transform 0.2s ease;
    }
    .faq__item[open] .faq__q::after {
      transform: translateY(4px) rotate(-135deg);
    }
    .faq__q:focus-visible {
      outline-offset: 2px;
    }
    .faq__a {
      margin: 0;
      padding-bottom: var(--space-md);
    }
  }
</style>
