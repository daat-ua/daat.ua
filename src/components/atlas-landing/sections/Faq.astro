---
import { faq } from "../../../data/faq";
---

<section class="for-whom faq" id="faq">
  <div class="wrap">
    <h2 class="section-title">
      <strong>Питання,</strong> які власники ставлять перед діагностикою
    </h2>
    <dl class="faq__list">
      {faq.map((item) => (
        <div class="faq__item">
          <dt set:html={item.q} />
          <dd set:html={item.a} />
        </div>
      ))}
    </dl>
  </div>
</section>

<style is:global>
  /* ---------- FAQ: two columns, typography of the roadmap's revenue table ---------- */
  .faq__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--space-2xl);
    width: var(--span-3);
    max-width: 100%;
    margin: var(--space-xl) 0 0;
  }
  .faq__item {
    padding: var(--space-md) 0;
    border-top: 1px solid rgb(237 233 222 / 0.12);
    font-size: var(--text-small);
  }
  .faq__item dt {
    /* same as the horizon column h4 */
    margin: 0;
    color: var(--c-white);
    font-size: var(--text-body);
    font-weight: 600;
    line-height: 1.3;
  }
  .faq__item dd {
    margin: var(--space-xs) 0 0;
    color: rgb(237 233 222 / 0.75);
    line-height: var(--leading-body);
  }
  .faq__item a {
    color: var(--c-cream);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: rgb(237 233 222 / 0.45);
    transition: text-decoration-color 0.2s ease;
  }
  .faq__item a:hover {
    text-decoration-color: currentColor;
  }

  @media (width < 64rem) {
    /* the slice is too narrow for a logo */
    .faq__list {
      grid-template-columns: 1fr;
      margin-top: 32px;
    }
  }
</style>
