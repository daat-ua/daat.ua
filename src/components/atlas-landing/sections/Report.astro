---
import { Image } from "astro:assets";
import maturity from "../../../assets/charts/maturity-scorecard.svg";
import priority from "../../../assets/charts/priority-quadrant.svg";
import radar from "../../../assets/charts/radar-it.svg";
import { reportSections, workingFiles } from "../../../data/report";

// Example charts from a real report; each opens full size in the lightbox
const charts = [
  { src: maturity, alt: "Приклад зі звіту: зрілість енейблерів за шкалою Ω з довірчими інтервалами" },
  { src: priority, alt: "Приклад зі звіту: пріоритети енейблерів, зрілість × сила доказів" },
  { src: radar, alt: "Приклад зі звіту: профіль RADAR-IT для всієї компанії" },
];
---

<section class="report" id="report" data-toc-theme="light">
  <div class="wrap">
    <h2 class="section-title">
      <strong>Що всередині звіту ATLAS</strong>&nbsp;— розділ за розділом
    </h2>
    <p class="report__intro">
      Звіт на <span class="nowrap">60+ сторінок</span> для тих, хто ухвалює рішення: відповідь&nbsp;— на першій
      сторінці, докази&nbsp;— далі, план зростання з конкретними практиками&nbsp;— наприкінці.
    </p>

    <div class="report__layout">
      <div class="report__charts">
        {charts.map((chart) => (
          <button class="chart-zoom" type="button" aria-label={`Відкрити графік на весь екран: ${chart.alt}`}>
            <Image src={chart.src} alt={chart.alt} layout="none" />
          </button>
        ))}
      </div>

      <div class="report__content">
        <ol class="report-toc">
          {reportSections.map((s) => (
            <li>
              <span class="report-toc__num">{s.num}</span>
              <h3 set:html={s.title} />
              <p set:html={s.text} />
            </li>
          ))}
        </ol>

        <div class="report__files">
          <p>А також робочі файли, які залишаються у вас:</p>
          <ul>
            {workingFiles.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </div>

        <div class="report__cta">
          <a class="btn btn--primary" href="#contact">
            Записатися на діагностичний дзвінок
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Full-size view for the charts -->
  <dialog class="lightbox" aria-label="Графік зі звіту">
    <img class="lightbox__img" alt="" />
    <button class="lightbox__close" type="button" aria-label="Закрити">
      ×
    </button>
  </dialog>
</section>

<script>
  // Charts open full size; a click anywhere (backdrop, image or the close button) closes the view
  const dialog = document.querySelector<HTMLDialogElement>(".lightbox")!;
  const img = dialog.querySelector<HTMLImageElement>(".lightbox__img")!;
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".chart-zoom")) {
    btn.addEventListener("click", () => {
      const chart = btn.querySelector("img")!;
      img.src = chart.currentSrc || chart.src;
      img.alt = chart.alt;
      dialog.showModal();
    });
  }
  dialog.addEventListener("click", () => dialog.close());
</script>

<style is:global>
  /* Same columns as the "Для кого" layout: charts where the Venn diagram is, text where the situations are */
  .report__layout {
    display: grid;
    grid-template-columns: 1fr calc(480 * var(--px));
    column-gap: var(--space-3xl);
    align-items: start;
    width: var(--span-3);
    max-width: 100%;
    margin-top: var(--space-xl);
  }
  /* Example charts from a real report, pinned beside the text (same offset as the TOC) */
  .report__charts {
    position: sticky;
    top: var(--space-3xl);
    display: grid;
    row-gap: var(--space-md);
  }
  .chart-zoom {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .chart-zoom img {
    display: block;
    width: 100%;
    height: auto;
  }
  .chart-zoom:focus-visible {
    outline-offset: 4px;
    border-radius: 4px;
  }
  /* Full-size chart overlay */
  .lightbox {
    max-width: min(92vw, 1200px);
    max-height: 92vh;
    padding: var(--space-lg);
    border: 0;
    border-radius: 12px;
    background: var(--c-paper);
    overflow: auto;
  }
  .lightbox::backdrop {
    background: rgb(14 21 27 / 0.82);
  }
  .lightbox__img {
    display: block;
    width: min(86vw, 1100px);
    max-height: 80vh;
    height: auto;
    object-fit: contain;
    cursor: zoom-out;
  }
  .lightbox__close {
    position: absolute;
    top: 8px;
    right: 12px;
    width: 44px;
    height: 44px;
    border: 0;
    background: none;
    color: var(--c-hero);
    font-size: 32px;
    line-height: 1;
    cursor: pointer;
  }
  .report__intro {
    max-width: var(--span-2);
    margin: var(--space-xl) 0 0;
    color: var(--c-ink);
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }
  .report-toc {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .report-toc li {
    display: grid;
    grid-template-columns: 2.4em 1fr;
    padding: var(--space-md) 0;
  }
  /* Dashed 2px separators between sections only (none above the first or below the last) */
  .report-toc li + li {
    border-top: 2px dashed rgb(28 38 50 / 0.25);
  }
  .report-toc__num {
    grid-row: span 2;
    padding-top: 0.2em;
    color: var(--c-ink);
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
  }
  .report-toc h3 {
    margin: 0;
    font-size: var(--text-lead);
    font-weight: 600;
    line-height: 1.2;
  }
  .report-toc p {
    margin: var(--space-xs) 0 0;
    color: var(--c-ink);
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }
  .report__files {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
  }
  .report__files p {
    margin: 0;
    font-size: var(--text-small);
    font-weight: 600;
  }
  .report__files ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .report__files li {
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid rgb(28 38 50 / 0.3);
    border-radius: 999px;
    font-size: var(--text-small);
    line-height: 1.2;
  }
  .report__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
    margin-top: var(--space-xl);
  }
  .report__cta .btn--primary {
    border-color: var(--c-primary);
    color: var(--c-white);
  }

  @media (width < 64rem) {
    .report__layout {
      grid-template-columns: 1fr;
      row-gap: 48px;
      width: auto;
    }
    .report__charts {
      position: static;
      order: 2;
      max-width: 480px;
    }
    .report__intro,
    .report-toc,
    .report__files,
    .report__cta {
      max-width: 640px;
    }
  }
</style>
