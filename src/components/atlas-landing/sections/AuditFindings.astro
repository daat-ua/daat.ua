---
import { getRelativeLocaleUrl } from "astro:i18n";
import { enablerNames, type Enabler } from "../../../data/enablers";
import { getFindingTeasers } from "../../../sanity/shared";
import { srcsetFor, urlFor } from "../../../sanity/image";
import Carousel, { type Teaser } from "../../ui/Carousel.astro";

interface Props {
  /** plain-text heading; the ATLAS page's "Знахідки аудитів: …" by default */
  title?: string;
  /** "Дивитися каталог" link in the heading */
  catalogLink?: boolean;
  /** the explainer paragraph under the heading */
  intro?: boolean;
  /** slug of a finding to leave out (the one whose page this is) */
  exclude?: string;
  /** only this enabler's findings (their cards then go without the enabler tag) */
  enabler?: Enabler;
  /** the section's id (an anchor); unique per page */
  id?: string;
  /** a line under the heading (in place of the ATLAS page's intro) */
  description?: string;
}

const { title, catalogLink = true, intro = true, exclude, enabler, id = "audit-findings", description } = Astro.props;

// The teasers come from the Sanity "Delivery audit findings" collection, newest first; each links to its page
// and is tagged with its enabler's Ukrainian name (no tag until one is chosen in the Studio).
// Card titles are passed to the carousel as HTML, so the plain-text titles are escaped.
const escape = (text: string) => text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const locale = Astro.currentLocale ?? "uk-UA";
const findings: Teaser[] = (await getFindingTeasers())
  .filter((f) => f.slug !== exclude && f.image?.asset && (!enabler || f.enabler === enabler))
  .map((f) => ({
    image: {
      src: urlFor(f.image!).width(640).height(640).fit("crop").url(),
      srcset: srcsetFor(f.image!, [320, 480, 640, 800], 1),
    },
    tag: f.enabler && !enabler ? enablerNames[f.enabler] : null,
    title: escape(f.title),
    href: getRelativeLocaleUrl(locale, `atlas/findings/${f.slug}`, { normalizeLocale: false }),
  }));
const catalogueHref = getRelativeLocaleUrl(locale, "atlas/findings", { normalizeLocale: false });
---

<section class="report" id={id} data-toc-theme="light">
  <div class="wrap">
    <h2 class="section-title">
      {title ?? (
        <>
          <strong>Знахідки аудитів:</strong> що ми бачимо в українських <span class="nowrap">IT-компаніях.</span>
        </>
      )}
      {catalogLink && (
        <>
          <br />
          <a class="finding__more findings__all" href={catalogueHref}>
            Дивитися&nbsp;каталог&nbsp;
            <svg class="findings__all-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.5 12L4.99997 12" />
              <path d="M13 18C13 18 19 13.5811 19 12C19 10.4188 13 6 13 6" />
            </svg>
          </a>
        </>
      )}
    </h2>
    {description && <p class="report__intro">{description}</p>}
    {intro && (
      <p class="report__intro">
        Результати нашої роботи у форматі практичних гайдів на <span class="nowrap">2–3 тис.</span> слів. Кожна
        знахідка&nbsp;— реальна проблема, яку ми виявили під час аудитів українських{" "}
        <span class="nowrap">IT-компаній</span>: як вона проявляється, звідки береться і як її вирішують команди.
      </p>
    )}

    <Carousel
      label={title ?? "Знахідки аудитів"}
      items={findings}
      more="Читати далі"
      prevLabel="Попередні знахідки"
      nextLabel="Наступні знахідки"
    />
  </div>
</section>

<style is:global>
  /* "Дивитися каталог" sits inside the heading, on its own line: heading size and weight, link colour and hover underline */
  .section-title .findings__all {
    display: inline;
    margin: 0;
    font: inherit;
    white-space: nowrap;
  }
  .findings__all-icon {
    width: 1em;
    height: 1em;
    vertical-align: -0.14em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s var(--ease-out);
  }
  .findings__all:hover .findings__all-icon,
  .findings__all:focus-visible .findings__all-icon {
    transform: translateX(3px);
  }
</style>
