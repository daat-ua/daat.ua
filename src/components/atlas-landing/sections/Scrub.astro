---
// Scroll-scrubbed clip under "Чому зараз?": a 121-frame sequence drawn to a canvas as the section scrolls into
// view, with three pillars fading in over its last frame. Frames live in public/frames/scrub/<width>/.
---

<section class="scrub" aria-label="Business strategy, technical excellence та delivery&nbsp;— з'єднані в одну систему">
  <img
    class="scrub__poster"
    src="/frames/scrub/1440/f001.webp"
    srcset="/frames/scrub/800/f001.webp 800w, /frames/scrub/1440/f001.webp 1440w, /frames/scrub/2042/f001.webp 2042w"
    sizes="100vw"
    width="1440"
    height="720"
    alt=""
    loading="lazy"
    decoding="async"
  />
  <canvas class="scrub__canvas" aria-hidden="true"></canvas>
  <ul class="pillars" aria-hidden="true">
    <li class="pillar pillar--technical">
      <span>
        Технологічна
        <br />
        досконалість
      </span>
    </li>
    <li class="pillar pillar--strategy">
      <span>
        Стратегія
        <br />
        IT-компанії
      </span>
    </li>
    <li class="pillar pillar--delivery">
      <span>Делівері</span>
    </li>
  </ul>
</section>

<script>
  import { frameSet, loadOrder, nearestLoaded } from "../../../scripts/frames";

  const FRAME_COUNT = 121;
  // The clip holds its first frame for the first 40% of the scroll range, then plays over the rest
  const START_AT = 0.4;

  const section = document.querySelector<HTMLElement>(".scrub")!;
  const canvas = section.querySelector<HTMLCanvasElement>(".scrub__canvas")!;
  const poster = section.querySelector<HTMLImageElement>(".scrub__poster")!;
  const ctx = canvas.getContext("2d")!;
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  const src = frameSet("scrub", section.clientWidth);
  const frames: HTMLImageElement[] = new Array(FRAME_COUNT);
  let current = -1;
  let ticking = false;

  // 0 when the section's top edge enters at the bottom of the viewport,
  // 1 when it reaches the top (or when the page can't scroll any further)
  function progress() {
    const top = section.getBoundingClientRect().top + scrollY;
    const start = Math.max(0, top - innerHeight);
    const maxScroll = document.documentElement.scrollHeight - innerHeight;
    const end = Math.min(top, maxScroll);
    if (end <= start) return 1;
    const p = (scrollY - start) / (end - start);
    return Math.min(1, Math.max(0, (p - START_AT) / (1 - START_AT)));
  }

  function render(force = false) {
    ticking = false;
    const p = reducedMotion ? 1 : progress();
    section.style.setProperty("--clip-progress", p.toFixed(3)); // pillars' opacity
    const i = nearestLoaded(frames, Math.round(p * (FRAME_COUNT - 1)));
    if (i < 0 || (i === current && !force)) return;
    current = i;
    ctx.drawImage(frames[i], 0, 0, canvas.width, canvas.height);
    poster.hidden = true;
  }

  function requestRender() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => render());
  }

  function resize() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.round(section.clientWidth * dpr);
    canvas.height = Math.round(section.clientHeight * dpr);
    ctx.imageSmoothingQuality = "high";
    render(true);
  }

  function startLoading() {
    for (const i of reducedMotion ? [FRAME_COUNT - 1] : loadOrder(FRAME_COUNT)) {
      const img = new Image();
      img.decoding = "async";
      img.onload = requestRender;
      img.src = src(i);
      frames[i] = img;
    }
  }

  // Start fetching frames once the section is within a couple of screens
  new IntersectionObserver(
    (entries, observer) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      observer.disconnect();
      startLoading();
    },
    { rootMargin: "200% 0px" },
  ).observe(section);

  resize();
  addEventListener("resize", resize);
  addEventListener("scroll", requestRender, { passive: true });
</script>

<style is:global>
  /* ---------- Scroll-scrubbed clip ---------- */
  /*
        Scrolls with the page like any other section. The clip advances from first to last frame
        while the section travels from the bottom edge of the viewport to the top edge.
      */
  .scrub {
    position: relative;
    z-index: 2;
    aspect-ratio: 2042 / 1020;
    overflow: hidden;
    background: #08090c;
  }
  .scrub__poster,
  .scrub__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .scrub__poster {
    object-fit: cover;
  }
  /* Three pillars over the final frame (Figma node 6:304); their opacity follows the clip's progress */
  .pillars {
    position: absolute;
    inset: 0;
    z-index: 1;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }
  .pillar {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--pillar-size, calc(121.5 * var(--px)));
    height: var(--pillar-size, calc(121.5 * var(--px)));
    border-radius: 50%;
    background: var(--c-peach);
    color: var(--c-header);
    font-size: var(--pillar-font, var(--text-small));
    font-weight: 600;
    line-height: 1.15;
    text-align: center;
    opacity: var(--clip-progress, 0); /* fades in with the clip: 0 at its start, 1 at its last frame */
    transform: translate(-50%, -50%);
  }
  /* Centre points as a share of the frame, so the circles stay on the traces at any width */
  .pillar--technical {
    --x: 13.628%;
    --y: 51.146%;
  }
  .pillar--strategy {
    --x: 50.104%;
    --y: 48.09%;
  }
  .pillar--delivery {
    --x: 88.073%;
    --y: 26.215%;
  }
  /* Fade into the "Для кого" section below (Figma "Rectangle 7") */
  .scrub::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(131.5 * var(--px));
    background: linear-gradient(to bottom, rgb(14 21 27 / 0), var(--c-night));
    pointer-events: none;
  }

  @media (width < 64rem) {
    .scrub::after {
      height: 64px;
    }
    .pillars {
      --pillar-size: clamp(68px, 17vw, 121.5px);
      --pillar-font: clamp(10px, 2.3vw, 17px);
    }
  }
</style>
