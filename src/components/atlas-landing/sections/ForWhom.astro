---
import { audiences } from "../../../data/for-whom";
---

<section class="for-whom" id="for-whom" data-audience="manager">
  <div class="wrap">
    <h2 class="section-title">
      <strong>Для кого ATLAS:</strong> оберіть свою ситуацію
    </h2>
    <p class="for-whom__intro">
      ATLAS відкалібровано для <span class="nowrap">IT-сервісних</span> і продуктових компаній на{" "}
      <span class="nowrap">50–500 FTE</span>. Одна методологія, одна шкала зрілості&nbsp;— і три погляди на компанію:
    </p>

    <div class="audience-tabs" role="tablist" aria-label="Оберіть свою ситуацію">
      {audiences.map((a, i) => (
        <button
          class="audience-tab"
          type="button"
          role="tab"
          id={`tab-${a.id}`}
          aria-controls={`panel-${a.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          data-audience={a.id}
        >
          <span class="audience-tab__title">{a.tab}</span>
        </button>
      ))}
    </div>

    <div class="for-whom__layout">
      <figure class="venn">
        <svg
          viewBox="0 0 892 846"
          role="img"
          aria-label="Три погляди на компанію: керую компанією, інвестую або купую, обираю підрядника. Перетини: продаж і купівля, вибір підрядника, постійний моніторинг; у центрі&nbsp;— одна шкала зрілості."
        >
          <circle class="venn__ring" cx="282" cy="282" r="280" />
          <circle class="venn__ring" cx="610" cy="282" r="280" />
          <circle class="venn__ring" cx="435" cy="564" r="280" />
          <circle class="venn__highlight" data-audience="manager" cx="282" cy="282" r="274" />
          <circle class="venn__highlight" data-audience="investor" cx="610" cy="282" r="274" />
          <circle class="venn__highlight" data-audience="contractor" cx="435" cy="564" r="274" />
          <text class="venn__label" data-audience="manager" x="107" y="228">
            <tspan x="107" dy="0">
              Керую
            </tspan>
            <tspan x="107" dy="43">
              компанією
            </tspan>
          </text>
          <text class="venn__label" data-audience="investor" x="645" y="228">
            <tspan x="645" dy="0">
              Інвестую
            </tspan>
            <tspan x="645" dy="43">
              або купую
            </tspan>
          </text>
          <text class="venn__label" data-audience="contractor" x="359" y="686">
            <tspan x="359" dy="0">
              Обираю
            </tspan>
            <tspan x="359" dy="43">
              підрядника
            </tspan>
          </text>
          <text class="venn__overlap" data-in="manager investor" x="376" y="204">
            <tspan x="376" dy="0">
              Продаж /
            </tspan>
            <tspan x="376" dy="38">
              купівля
            </tspan>
          </text>
          <text class="venn__overlap" data-in="manager investor contractor" x="393" y="345">
            <tspan x="393" dy="0">
              Одна
            </tspan>
            <tspan x="393" dy="38">
              шкала
            </tspan>
            <tspan x="393" dy="38">
              зрілості
            </tspan>
          </text>
          <text class="venn__overlap" data-in="manager contractor" x="220" y="450">
            <tspan x="220" dy="0">
              Вибір
            </tspan>
            <tspan x="220" dy="38">
              підрядника
            </tspan>
          </text>
          <text class="venn__overlap" data-in="investor contractor" x="537" y="450">
            <tspan x="537" dy="0">
              Постійний
            </tspan>
            <tspan x="537" dy="38">
              моніторинг
            </tspan>
          </text>
        </svg>
        <figcaption>
          Одна методологія&nbsp;— три погляди на компанію. Перетини&nbsp;— ситуації, де ATLAS бачить ту саму компанію з
          двох боків: продавця й покупця, підрядника й замовника.
        </figcaption>
      </figure>

      <div>
        {audiences.map((a, i) => (
          <div role="tabpanel" id={`panel-${a.id}`} aria-labelledby={`tab-${a.id}`} hidden={i !== 0}>
            <p class="situations__intro" set:html={a.intro} />
            <ul class="situations">
              {a.situations.map((s, j) => (
                <li class:list={["situation", { "is-open": j === 0 }]}>
                  <h3 class="situation__heading">
                    <button
                      class="situation__toggle"
                      type="button"
                      id={`situation-${s.id}-toggle`}
                      aria-expanded={j === 0 ? "true" : "false"}
                      aria-controls={`situation-${s.id}`}
                    >
                      <svg class="situation__icon" viewBox="0 0 73 73" aria-hidden="true">
                        <path class="chev--a" d="M18 27C24 35 31 45.6 36.5 45.6S49 35 55 27" />
                        <path class="chev--b" d="M18 27C24 35 31 45.6 36.5 45.6S49 35 55 27" />
                      </svg>
                      <span class="situation__title" set:html={s.title} />
                      <span class="situation__sub" set:html={s.sub} />
                    </button>
                  </h3>
                  <div
                    class="situation__panel"
                    id={`situation-${s.id}`}
                    role="region"
                    aria-labelledby={`situation-${s.id}-toggle`}
                  >
                    <div class="situation__inner">
                      <div class="situation__body">
                        <ul class="dots">
                          {s.items.map((item) => (
                            <li set:html={item} />
                          ))}
                        </ul>
                      </div>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Audience tabs (arrow keys move between them), the Venn diagram (clicking a circle selects its audience; in
  // overlaps the nearest centre wins) and the situations accordion (one open at a time within each list).
  const section = document.querySelector<HTMLElement>("#for-whom")!;
  const tabs = [...section.querySelectorAll<HTMLButtonElement>('[role="tab"]')];

  function select(tab: HTMLButtonElement, focus = false) {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute("aria-selected", String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute("aria-controls")!)!.hidden = !on;
    }
    section.dataset.audience = tab.dataset.audience;
    if (focus) tab.focus();
  }
  for (const tab of tabs) {
    tab.addEventListener("click", () => select(tab));
    tab.addEventListener("keydown", (e) => {
      const i = tabs.indexOf(tab);
      const next = ({ ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 } as Record<string, number>)[
        e.key
      ];
      if (next === undefined) return;
      e.preventDefault();
      select(tabs[(next + tabs.length) % tabs.length], true);
    });
  }

  const svg = section.querySelector<SVGSVGElement>(".venn svg")!;
  const circles = [...svg.querySelectorAll<SVGCircleElement>(".venn__highlight")].map((c) => ({
    audience: c.dataset.audience!,
    cx: Number(c.getAttribute("cx")),
    cy: Number(c.getAttribute("cy")),
    r: 282,
  }));
  function audienceAt(e: PointerEvent | MouseEvent) {
    const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(svg.getScreenCTM()!.inverse());
    return circles
      .map((c) => ({ ...c, d: Math.hypot(p.x - c.cx, p.y - c.cy) }))
      .filter((c) => c.d <= c.r)
      .sort((a, b) => a.d - b.d)[0]?.audience;
  }
  svg.addEventListener("pointermove", (e) => {
    const audience = audienceAt(e);
    svg.classList.toggle("is-pointing", !!audience);
    if (audience) section.dataset.hover = audience;
    else delete section.dataset.hover;
  });
  svg.addEventListener("pointerleave", () => {
    svg.classList.remove("is-pointing");
    delete section.dataset.hover;
  });
  svg.addEventListener("click", (e) => {
    const audience = audienceAt(e);
    const tab = tabs.find((t) => t.dataset.audience === audience);
    if (tab) select(tab);
  });

  // height and icon animate in CSS
  function setOpen(item: Element, open: boolean) {
    item.classList.toggle("is-open", open);
    item.querySelector(".situation__toggle")!.setAttribute("aria-expanded", String(open));
  }
  for (const item of section.querySelectorAll(".situation")) {
    item.querySelector(".situation__toggle")!.addEventListener("click", () => {
      const open = !item.classList.contains("is-open");
      for (const other of item.parentElement!.children) if (other !== item) setOpen(other, false);
      setOpen(item, open);
    });
  }
</script>

<style is:global>
  /* Venn diagram: one circle per audience; the selected one is drawn in blue */
  /* The diagram and its caption stay in view while the situations list scrolls (same offset as the TOC) */
  .venn {
    position: sticky;
    top: var(--space-3xl);
    margin: 0;
  }
  .venn svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .venn__ring {
    fill: none;
    stroke: var(--c-peach);
    stroke-width: 4;
  }
  .venn__highlight {
    fill: none;
    stroke: var(--c-primary);
    stroke-width: 16;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .venn__label {
    font-family: var(--font-body);
    font-size: 36px;
    font-weight: 700;
    fill: var(--c-cream);
    fill-opacity: 0.5;
    transition: fill-opacity 0.25s ease;
  }
  .venn__overlap {
    font-family: var(--font-body);
    font-size: 32px;
    fill: var(--c-white);
    fill-opacity: 0.5;
    transition: fill-opacity 0.25s ease;
  }
  /* Circles are clickable: hovering previews the highlight */
  .venn svg.is-pointing {
    cursor: pointer;
  }
  .venn figcaption {
    margin-top: var(--space-xl);
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }
  .situations__intro {
    margin: 0;
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }
  .situations {
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
  }
  .situation {
    position: relative;
    padding-bottom: var(--space-lg);
  }
  /* Line after each row: 25% by default, full strength under the open row */
  .situation::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: url("../../../assets/dividers/divider-dark.svg") no-repeat 0 0 / 100% 2px;
    opacity: 0.25;
    transition: opacity 0.4s var(--ease-out);
  }
  .situation.is-open::after {
    opacity: 1;
  }
  .situation__heading {
    margin: 0;
    font: inherit;
  }
  .situation__toggle {
    display: grid;
    grid-template-columns: calc(36.5 * var(--px)) 1fr;
    column-gap: var(--space-md);
    width: 100%;
    padding: var(--space-lg) 0 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .situation__toggle:focus-visible {
    outline-offset: 6px;
    border-radius: 4px;
  }
  .situation__toggle:hover .situation__title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  /* Icon: two chevron strokes. Closed they overlap as one "down" chevron;
         open, one rises and the other flips up through a flat line (Figma "unfold less") */
  .situation__icon {
    grid-row: span 2;
    width: calc(36.5 * var(--px));
    height: calc(36.5 * var(--px));
    margin-top: calc((var(--text-lead) * 1.2 - 36.5 * var(--px)) / 2); /* centred on the title line */
    overflow: visible;
  }
  .situation__icon path {
    fill: none;
    stroke: var(--c-peach);
    stroke-width: calc(2.3 * var(--px)); /* screen units (non-scaling): Figma's 4.6/73 of the 36.5 icon */
    stroke-linecap: round;
    vector-effect: non-scaling-stroke; /* line weight stays constant while the chevron flips */
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.4s var(--ease-out);
  }
  .situation.is-open .chev--a {
    transform: translateY(-7.5px) scaleY(0.83);
  }
  .situation.is-open .chev--b {
    transform: translateY(20px) scaleY(-0.83);
  }
  .situation__title,
  .situation__sub {
    grid-column: 2;
  }
  .situation__title {
    font-size: var(--text-lead);
    font-weight: 500; /* Medium, like the "Чому зараз?" card titles */
    line-height: 1.2;
  }
  .situation__sub {
    margin-top: var(--space-xs);
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }
  /* Panel: animates height by transitioning a grid row from 0fr to 1fr */
  .situation__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s var(--ease-out);
  }
  .situation.is-open .situation__panel {
    grid-template-rows: 1fr;
  }
  .situation__inner {
    min-height: 0;
    overflow: hidden;
    visibility: hidden; /* collapsed content is out of the tab order and the accessibility tree */
    opacity: 0;
    transition:
      opacity 0.25s ease,
      visibility 0s 0.4s;
  }
  .situation.is-open .situation__inner {
    visibility: visible;
    opacity: 1;
    transition:
      opacity 0.3s ease 0.1s,
      visibility 0s;
  }
  .situation__body {
    padding: var(--space-xs) 0 0 calc(36.5 * var(--px) + var(--space-md));
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }
  .situation__body p {
    margin: 0;
  }

  @media (width < 64rem) {
    .venn {
      position: static;
      max-width: 400px;
    }
    .situation {
      padding-bottom: 24px;
    }
    .situation__toggle {
      grid-template-columns: 28px 1fr;
      column-gap: 16px;
      padding-top: 24px;
    }
    .situation__icon {
      width: 28px;
      height: 28px;
      margin-top: calc((var(--text-lead) * 1.2 - 28px) / 2);
    }
    .situation__icon path {
      stroke-width: 1.8px;
    }
    .situation__body {
      padding-left: 44px;
    }
  }
</style>
