---
import { Image } from "astro:assets";
import full from "../../assets/dividers/divider-full.svg";
import fade from "../../assets/dividers/divider-fade.svg";

interface Props {
  class?: string;
  /** orange fading into whatever ground it's on (light pages), instead of orange-to-blue (a blue section) */
  fade?: boolean;
}
const { class: className = "why__divider", fade: fading = false } = Astro.props;
---

<!-- the orange rule between blocks: to blue in a blue section, fading out on other grounds -->
<Image class={className} src={fading ? fade : full} alt="" layout="none" />
