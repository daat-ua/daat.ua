---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

// Horizontal teaser carousel (audit findings, case studies): scroll-snapping track, prev/next by a page,
// page dashes that follow the scroll position. Styles are in patterns.css (.findings, .finding…).

/** an image served elsewhere (the Sanity CDN), with its srcset already built */
export interface RemoteImage {
  src: string;
  srcset: string;
}

export interface Teaser {
  image: ImageMetadata | RemoteImage;
  /** the label on the image; none when empty */
  tag?: string | null;
  /** may hold HTML (&nbsp;, nowrap spans) */
  title: string;
  href: string;
}

interface Props {
  label: string;
  items: Teaser[];
  /** link text under each teaser, e.g. "Читати далі" */
  more: string;
  prevLabel: string;
  nextLabel: string;
  /** heading level of the teaser titles, one below the heading the carousel sits under */
  headingLevel?: 3 | 4;
}

const { label, items, more, prevLabel, nextLabel, headingLevel = 3 } = Astro.props;
const Title = `h${headingLevel}` as "h3" | "h4";
---

<div class="findings" role="region" aria-roledescription="carousel" aria-label={label}>
  <ul class="findings__track" tabindex="0">
    {items.map((item) => (
      <li class="finding">
        <div class="finding__media">
          {/* the image leads where "more" does; skipped by keyboard and screen readers, which get that link
              (the tag stays outside it, so they still read it) */}
          <a class="finding__link" href={item.href} tabindex="-1" aria-hidden="true">
            {"srcset" in item.image ? (
              <img
                src={item.image.src}
                srcset={item.image.srcset}
                sizes="(width < 64rem) 78vw, 26vw"
                alt=""
                loading="lazy"
                decoding="async"
              />
            ) : (
              <Image
                src={item.image}
                alt=""
                widths={[320, 480, 640, 800]}
                sizes="(width < 64rem) 78vw, 26vw"
                layout="none"
              />
            )}
          </a>
          {item.tag && <span class="finding__tag">{item.tag}</span>}
        </div>
        <Title class="finding__title" set:html={item.title} />
        <a class="finding__more" href={item.href}>
          {more} <span aria-hidden="true">›</span>
        </a>
      </li>
    ))}
  </ul>
  <div class="findings__controls">
    <div class="findings__pages" aria-hidden="true"></div>
    <button class="findings__nav" type="button" data-dir="-1" aria-label={prevLabel}>
      ‹
    </button>
    <button class="findings__nav" type="button" data-dir="1" aria-label={nextLabel}>
      ›
    </button>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll(".findings")) {
    const track = root.querySelector<HTMLElement>(".findings__track")!;
    const pagesEl = root.querySelector<HTMLElement>(".findings__pages")!;
    const controls = root.querySelector<HTMLElement>(".findings__controls")!;
    const [prev, next] = root.querySelectorAll<HTMLButtonElement>(".findings__nav");

    const pageCount = () =>
      track.clientWidth ? Math.max(1, Math.ceil(track.scrollWidth / track.clientWidth - 0.05)) : 1; // 1 until laid out
    function update() {
      const n = pageCount();
      // nothing to scroll to (every teaser already in view, at this width): no arrows, no page dashes
      controls.hidden = n <= 1;
      if (pagesEl.children.length !== n) pagesEl.innerHTML = "<span></span>".repeat(n);
      const max = track.scrollWidth - track.clientWidth;
      const current = Math.round((max > 0 ? track.scrollLeft / max : 0) * (n - 1));
      [...pagesEl.children].forEach((s, i) => s.classList.toggle("is-current", i === current));
      // aria-disabled, not disabled: a focused button that reaches the end keeps keyboard focus
      prev.setAttribute("aria-disabled", String(track.scrollLeft <= 2));
      next.setAttribute("aria-disabled", String(track.scrollLeft >= max - 2));
    }
    for (const btn of [prev, next]) {
      btn.addEventListener("click", () => {
        if (btn.getAttribute("aria-disabled") === "true") return;
        track.scrollBy({ left: Number(btn.dataset.dir) * track.clientWidth * 0.9 });
      });
    }
    track.addEventListener("scroll", () => requestAnimationFrame(update), { passive: true });
    addEventListener("resize", update);
    update();
  }
</script>
