---
import type { TypedObjectProps } from "astro-portabletext/types";
import { PortableText } from "astro-portabletext";

// A table in an article's body (`richTableBlock`, the Rich Table plugin in the Studio): optional column titles and
// row titles, each cell a short Portable Text. It scrolls sideways on its own when it's wider than the text.
type Props = TypedObjectProps;

interface RichTable {
  rows: { _key: string; title?: string; cells?: { _key: string; content: TypedObjectProps["node"][] }[] }[];
  columnHeaders?: { _key: string; title?: string }[];
  hasColumnTitles?: boolean;
  hasRowTitles?: boolean;
}

const { rows, columnHeaders = [], hasColumnTitles, hasRowTitles } = Astro.props.node as unknown as RichTable;
---

<div class="body-table" tabindex="0" role="region" aria-label="Таблиця">
  <table>
    {hasColumnTitles && (
      <thead>
        <tr>
          {hasRowTitles && <td />}
          {columnHeaders.map((header) => (
            <th scope="col">{header.title}</th>
          ))}
        </tr>
      </thead>
    )}
    <tbody>
      {rows.map((row) => (
        <tr>
          {hasRowTitles && <th scope="row">{row.title}</th>}
          {row.cells?.map((cell) => (
            <td>
              <PortableText value={cell.content} />
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
<style>
  .body-table {
    margin: var(--space-lg) 0;
    overflow-x: auto;
  }
  .body-table:focus-visible {
    outline: 3px solid var(--c-accent);
    outline-offset: 3px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }
  th,
  td {
    padding: var(--space-xs) var(--space-sm) var(--space-xs) 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
  }
  thead th {
    border-bottom: 2px solid var(--c-hero);
    font-weight: 600;
  }
  thead td {
    border-bottom: 2px solid var(--c-hero);
  }
  tbody th {
    font-weight: 500;
  }
  /* a cell's text is a paragraph or two: no gap above the first or below the last */
  td :global(p) {
    margin: 0;
  }
  td :global(p + p) {
    margin-top: var(--space-xs);
  }
</style>
