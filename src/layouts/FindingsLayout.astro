---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Base from "./Base.astro";
import Footer from "../components/Footer.astro";
import ArrowLeft from "../assets/icons/icon-arrow-left.svg";
import { srcsetFor, urlFor } from "../sanity/image";
import type { SanityImageCrop, SanityImageHotspot } from "../sanity/sanity.types";

// The delivery-audit findings' pages (a finding, the catalogue): Base on a lighter paper, a hero with the
// artwork fading into the page, a breadcrumb back and the title. The hero slot adds to the title block
// (a finding's author, the catalogue's intro); the default slot is the page below it.

interface HeroImage {
  asset: { _id: string; metadata?: { lqip: string | null } | null } | null;
  hotspot?: SanityImageHotspot | null;
  crop?: SanityImageCrop | null;
}

interface Props {
  /** the document title */
  title: string;
  description: string;
  noindex?: boolean;
  /** the hero's artwork: a Sanity image, or a local one */
  image?: HeroImage | ImageMetadata | null;
  /** the breadcrumb: where it leads and what it says */
  crumb: { href: string; label: string };
  /** the page's h1 */
  heading: string;
}

const { title, description, noindex = false, image, crumb, heading } = Astro.props;
const isLocal = (img: typeof image): img is ImageMetadata => !!img && "src" in img;
const sanityImage = image && !isLocal(image) ? image : null;
const lqip = sanityImage?.asset?.metadata?.lqip;
---

<Base title={title} description={description} noindex={noindex}>
  <main id="main" class="finding-page">
    <!-- ═══ Hero: the artwork fades into the page ═══ -->
    <header class="finding-hero">
      {isLocal(image) ? (
        <div class="finding-hero__art" aria-hidden="true">
          <Picture
            src={image}
            alt=""
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            widths={[640, 960, 1440, 1920, 2400].filter((w) => w <= image.width)}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            layout="none"
          />
        </div>
      ) : (
        sanityImage?.asset && (
          <div class="finding-hero__art" aria-hidden="true" style={lqip ? `background-image: url(${lqip})` : undefined}>
            <img
              src={urlFor(sanityImage).width(1440).url()}
              srcset={srcsetFor(sanityImage, [640, 960, 1440, 1920, 2400])}
              sizes="100vw"
              alt=""
              fetchpriority="high"
            />
          </div>
        )
      )}
      <div class="wrap finding-hero__inner">
        <nav aria-label="Хлібні крихти">
          <a class="finding-crumb" href={crumb.href}>
            <ArrowLeft class="finding-crumb__icon" aria-hidden="true" />
            <span>{crumb.label}</span>
          </a>
        </nav>
        <h1 class="finding-title">{heading}</h1>
        <slot name="hero" />
      </div>
    </header>

    <slot />
  </main>
  <Footer />
</Base>

<style>
  /* these pages run on a lighter paper, halfway to white (#faf9f6): the content, the findings section,
     the footer and the menu panel all take it from the token */
  :global(body:has(.finding-page)) {
    --c-paper: color-mix(in srgb, var(--color-paper) 50%, var(--color-white));
  }
  .finding-page {
    --ink-soft: rgb(28 38 50 / 0.72); /* secondary text on paper */
    --rule: rgb(28 38 50 / 0.12);
    background: var(--c-paper);
    color: var(--c-hero);
  }

  /* ---------- Hero ---------- */
  /* As tall as its content: the breadcrumb starts --hero-pad-top (200 at 1440) below the bar, well clear
     of the logo hanging 63 below it, and scales with the page like everything else, not with the window's
     height. */
  .finding-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    --hero-pad-top: calc(200 * var(--px));
    overflow: hidden;
  }
  .finding-hero__art,
  .finding-hero__art :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* the blurred preview (Sanity's LQIP) shows until the artwork loads */
  .finding-hero__art {
    background: center / cover no-repeat;
  }
  /* the artwork fades into the paper so the title reads over it */
  .finding-hero__art::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--c-paper) 20%, transparent),
      color-mix(in srgb, var(--c-paper) 72%, transparent) 55%,
      var(--c-paper)
    );
  }
  .finding-hero__inner {
    display: grid;
    row-gap: var(--space-xl);
    width: 100%;
    padding-top: var(--hero-pad-top);
    padding-bottom: var(--space-2xl);
  }
  .finding-crumb {
    display: inline-flex;
    align-items: center;
    vertical-align: top; /* an inline-flex box on the baseline would add the descender space below it */
    gap: 0.35em;
    /* the lead paragraph's type, in Medium */
    font-size: var(--text-body);
    font-weight: 500;
    line-height: var(--leading-body);
    text-decoration-line: none; /* the longhands: the shorthand would reset the thickness */
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
    transition: color 0.2s ease;
  }
  .finding-crumb:hover {
    color: var(--c-primary);
  }
  /* only the words are underlined, not the arrow */
  .finding-crumb:hover span {
    text-decoration-line: underline;
  }
  .finding-crumb :global(.finding-crumb__icon) {
    flex: none;
    width: 1.2em;
    height: 1.2em;
    transition: translate 0.2s var(--ease-out);
  }
  /* the arrow nudges the way it points, as "Дивитися каталог" does on the ATLAS page */
  .finding-crumb:is(:hover, :focus-visible) :global(.finding-crumb__icon) {
    translate: -3px 0;
  }
  .finding-title {
    max-width: calc(1017 * var(--px));
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 600;
    line-height: var(--leading-display);
    font-feature-settings: "dlig" 1;
  }

  @media (width < 64rem) {
    .finding-hero {
      --hero-pad-top: 104px; /* the logo hangs 35px below the bar */
    }
    .finding-hero__inner {
      row-gap: 24px;
      padding-bottom: 40px;
    }
  }
</style>
