---
import { Font, getImage } from "astro:assets";
import faviconSource from "../assets/images/favicon.png";
import GlobalMenu from "../components/GlobalMenu.astro";
import CookieConsent from "../components/CookieConsent.astro";
import PageTransition from "../components/PageTransition.astro";
import Header from "../components/Header.astro";
import { clip, type ShareImage } from "../data/share";
import { breadcrumbList, jsonLd, siteGraph } from "../data/structured-data";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** keep the page out of search results (demo and service pages) */
  noindex?: boolean;
  /** the image a shared link shows (og:image); without one, the site's default (public/share.png) */
  shareImage?: ShareImage;
  /** "article" for a page made from a document (a finding, a case, an episode, an article) */
  type?: "website" | "article";
  /** the page's canonical URL when it isn't this one (a case first published elsewhere) */
  canonicalUrl?: string | null;
  /** the trail to this page for search engines (BreadcrumbList): the sections above it, then the page (no href) */
  breadcrumbs?: { name: string; href?: string }[];
}

const { title: rawTitle, description: rawDescription, noindex = false, type = "website", canonicalUrl } = Astro.props;
const title = rawTitle.replace(/\s+/g, " ").trim();
// search engines show ~160 characters: a longer description is cut between words, not mid-word
const description = clip(rawDescription);
const locale = Astro.currentLocale ?? "uk-UA";
// pages are built as .html files but served without the extension; the 404 page gets no canonical URL
const path = Astro.url.pathname.replace(/\.html$/, "");
const canonical = path === "/404" ? undefined : (canonicalUrl ?? new URL(path, Astro.site).href);
const shareImage = Astro.props.shareImage ?? {
  url: new URL("/share.png", Astro.site).href,
  width: 1200,
  height: 630,
  alt: "Daat",
};

// favicons from the square "D" mark: PNG for the tab, 180px for iOS home screens
const favicon = await getImage({ src: faviconSource, width: 32, height: 32, format: "png" });
const touchIcon = await getImage({ src: faviconSource, width: 180, height: 180, format: "png" });

// structured data: the organisation and the site on every page; the breadcrumb trail on pages below a section
const site = Astro.site ?? new URL("https://daat.ua");
const siteData = jsonLd(siteGraph(new URL(touchIcon.src, site).href));
const { breadcrumbs } = Astro.props;
const breadcrumbData =
  breadcrumbs && breadcrumbs.length > 1 && canonical
    ? jsonLd(breadcrumbList(breadcrumbs.map(({ name, href }) => ({ name, url: new URL(href ?? path, site).href }))))
    : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang={locale} href={canonical} />
      </>
    )}
    <!-- a shared link's card (Open Graph; X reads these too, with its own card type) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Daat" />
    <meta property="og:locale" content={locale.replace("-", "_")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage.url} />
    <meta property="og:image:width" content={String(shareImage.width)} />
    <meta property="og:image:height" content={String(shareImage.height)} />
    <meta property="og:image:alt" content={shareImage.alt ?? title} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={siteData} />
    {breadcrumbData && <script type="application/ld+json" set:html={breadcrumbData} />}
    <!-- Ahrefs Web Analytics (no cookies), on every page -->
    <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="STrJIQfxAdmMR6JOryVuoQ" async></script>
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    <!-- Preload only what's above the fold: the H1 (Turns Light + Medium) and the hero body (Commons Regular) -->
    <Font cssVariable="--font-turns" preload={[{ weight: 300 }, { weight: 500 }]} />
    <Font cssVariable="--font-commons" preload={[{ weight: 400 }]} />
    <!-- Page transitions (src/scripts/page-transition.ts): a page reached through one starts covered, or with its
         content hidden, from the first paint; the transition's second half then reveals it. Undone after 4s if
         that script never runs. -->
    <script is:inline>
      (() => {
        try {
          const key = "daat:page-transition";
          const raw = sessionStorage.getItem(key);
          if (!raw) return;
          sessionStorage.removeItem(key);
          const note = JSON.parse(raw);
          if (Date.now() - note.at > 5000) return;
          // less motion asked for since the click: a plain fade, whatever the link chose
          if (matchMedia("(prefers-reduced-motion: reduce)").matches) note.kind = "fade";
          window.__pageTransition = note;
          document.documentElement.dataset.pt = note.kind;
          setTimeout(() => {
            if (!window.__pageTransitionDone) delete document.documentElement.dataset.pt;
          }, 4000);
        } catch {
          // storage refused: the page shows as usual
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Перейти до змісту
    </a>
    <!-- every page gets the header and the menu its button opens -->
    <Header />
    <slot />
    <GlobalMenu />
    <CookieConsent />
    <PageTransition />
    <script>
      import "../scripts/in-page-links";
    </script>
  </body>
</html>
