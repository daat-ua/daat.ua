# Serves the static Astro build on Railway. Railway provides $PORT.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Astro's hashed bundles and optimised images never change: cache for a year
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# frame sequences and other public assets: cache for a week
	@assets path /frames/* /fonts/* /favicon*
	header @assets Cache-Control "public, max-age=604800"

	# pages: always revalidate so deploys show up at once
	@html path / *.html
	header @html Cache-Control "public, max-age=0, must-revalidate"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	try_files {path} {path}/ {path}.html
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
