# Serves the static Astro build on Railway. Railway provides $PORT.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Astro's hashed bundles, fonts and optimised images never change: cache for a year
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# frame sequences (not hashed): cache for a week
	@frames path /frames/*
	header @frames Cache-Control "public, max-age=604800"

	# pages: always revalidate so deploys show up at once
	@html path / /uk-UA/* *.html
	header @html Cache-Control "public, max-age=0, must-revalidate"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# the root and the bare locale lead to the ATLAS page; 302, so the target can change later
	# (e.g. language detection once there are more locales)
	redir / /uk-UA/atlas 302
	redir /uk-UA /uk-UA/atlas 302
	redir /uk-UA/ /uk-UA/atlas 302
	redir /uk-UA/atlas/ /uk-UA/atlas 301

	# findings on the previous daat.ua site moved to the ATLAS section (Sanity slugs are unchanged)
	@oldFinding path_regexp oldFinding ^/insights/delivery-audit-findings/([^/]+)/?$
	redir @oldFinding /uk-UA/atlas/findings/{re.oldFinding.1} 301

	# pages are built as /uk-UA/atlas.html and served without the extension
	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors {
		# a missing file must not inherit the long-lived caching set above
		header Cache-Control "no-store"
		rewrite * /404.html
		file_server
	}
}
