# Booking a call with the founders on finding pages (Cal.com API v2, called from the browser).
# Public identifiers, not secrets: they end up in the page. Leave unset to show only a link to the booking
# page (the dev server then simulates slots and the booking). On Railway, set them as service variables.

# The event type to book: its numeric ID (Cal.com → Event Types → the event: the number in its URL,
# e.g. app.cal.com/event-types/7834639). Not the hash from a private booking link.
# The build stops with an error if this is anything but digits.
PUBLIC_CAL_EVENT_TYPE_ID=

# The public booking page, the fallback when slots can't be loaded, e.g. https://cal.com/daat/atlas-call
PUBLIC_CAL_BOOKING_URL=

# Never put a Cal.com API key here: no PUBLIC_ variable may hold a secret, and the browser flow needs none.
